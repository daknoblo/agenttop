def header_parts(text, notice, width):
    available = max(0, width - 1)
    right = clip(notice, available)
    left_width = max(0, available - text_width(right) - (1 if right else 0))
    return pad_line(clip(text, left_width), available - text_width(right)), right


def filter_hint(show_done, activity):
    return f" d finished:{'show' if show_done else 'hide'}  a activity:{ACTIVITY_FILTERS[activity]} "


def table_row_style(kind, status, selected, use_color):
    import curses
    if status == "input":
        color = curses.color_pair(8 if selected else 7) if use_color else (curses.A_REVERSE if selected else 0)
        return color | curses.A_BOLD | (curses.A_UNDERLINE if kind == "session" else 0)
    if selected:
        return (curses.color_pair(6) if use_color else curses.A_REVERSE) | curses.A_BOLD
    if kind == "session":
        return (curses.color_pair(2 if status == "waiting" else 3) if use_color else 0) | curses.A_BOLD | curses.A_UNDERLINE
    pairs = {"running": 1, "starting": 2, "idle": 3, "done": 4, "failed": 5, "cancelled": 2, "waiting": 2}
    return curses.color_pair(pairs.get(status, 0)) if use_color else 0


def run_tui(mon: Monitor, interval: float, tree=True, sess_filter=None, all_done=False,
            sort_key="runtime", query="", check_updates=True, activity="all"):
    import curses

    checker = UpdateChecker() if check_updates else None

    def main(stdscr):
        try:
            curses.curs_set(0)
        except curses.error:
            pass                                    # terminal without cursor visibility control
        stdscr.keypad(True)
        stdscr.timeout(120)                         # lets ncurses assemble escape sequences
        try:
            curses.set_escdelay(25)
        except (AttributeError, curses.error):
            pass
        use_color = curses.has_colors()
        if use_color:
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_GREEN, -1)
            curses.init_pair(2, curses.COLOR_YELLOW, -1)
            curses.init_pair(3, curses.COLOR_CYAN, -1)
            curses.init_pair(4, curses.COLOR_BLUE, -1)
            curses.init_pair(5, curses.COLOR_RED, -1)
            curses.init_pair(6, curses.COLOR_BLACK, curses.COLOR_WHITE)
            curses.init_pair(7, curses.COLOR_MAGENTA, -1)
            curses.init_pair(8, curses.COLOR_BLACK, curses.COLOR_MAGENTA)

        show_done = all_done
        current_sort = sort_key
        current_activity = activity
        activity_cycle = tuple(ACTIVITY_FILTERS)
        sort_cycle = ["runtime", "start", "idle", "status", "name"]
        tree_mode = tree
        collapsed = set()
        session_focus = sess_filter
        cursor = 0
        detail = None
        detail_scroll = 0
        detail_limit = 0
        last_poll = 0.0
        body = []
        search = query
        editing_search = False
        show_help = False

        while True:
            notice = (checker.poll() if checker else
                      UpdateNotice("disabled", "Updates off", ""))
            if time.time() - last_poll >= interval:
                mon.refresh()
                last_poll = time.time()

            rows, now, sessions = mon.select(show_done, current_sort, session_focus, search, current_activity)
            height, width = stdscr.getmaxyx()
            stdscr.erase()

            running, starting, idle, done = mon.counts(rows)
            total = aic_summary(mon)
            waiting = sum(a.display_status == "waiting" for a in rows)
            input_agents, input_sessions = mon.input_attention()
            attention = f"INPUT {input_agents + input_sessions}" if input_agents or input_sessions else ""
            title = (f" agenttop {version()}{' | ' + attention if attention else ''}"
                     f"{' | ' + total if total else ''}  {datetime.now().strftime('%H:%M:%S')} ")
            summary = (f" running {running}  starting {starting}  idle {idle}  done {done} "
                       f" waiting {waiting}"
                       f"  | sessions {len(sessions)}  logs {len(mon.files)}  sort:{current_sort}"
                       f"{'  tree' if tree_mode else '  flat'}  activity:{ACTIVITY_FILTERS[current_activity]}"
                       f"{'  +finished' if show_done else ''}"
                       f"{'  filter:' + session_focus[:8] if session_focus else ''} ")
            try:
                left, right = header_parts(title + summary, notice.text, width)
                stdscr.addnstr(0, 0, left, len(left),
                               curses.color_pair(6) if use_color else curses.A_REVERSE)
                color = {"available": 2, "error": 5, "current": 1,
                         "diverged": 2, "restart": 2}.get(notice.status, 6)
                stdscr.addnstr(0, text_width(left), right, len(right),
                               (curses.color_pair(color) if use_color else curses.A_REVERSE) | curses.A_BOLD)
                if attention and attention in left:
                    column = text_width(left[:left.index(attention)])
                    stdscr.addnstr(0, column, attention, len(attention),
                                   (curses.color_pair(8) if use_color else curses.A_REVERSE) | curses.A_BOLD)
            except curses.error:
                pass

            if show_help:
                help_lines = [
                    "agenttop - local Copilot session and agent monitor",
                    "Up/Down, j/k: move    Enter: expand session / agent details",
                    "d: show/hide done, failed and cancelled    t: tree/flat    s: sort",
                    "a: cycle activity - all / active (running+starting only) / last 2h",
                    "The 2h filter uses the last recorded event; d still controls finished entries.",
                    "f: cycle session focus    /: search    Esc: clear search",
                    "r: rescan logs now    ?: help    q: back / quit",
                    f"Sources: {SOURCE_GLYPH['cli']} CLI history, {SOURCE_GLYPH['vscode']} VS Code AHP",
                    "Idle background agents can be resumed with write_agent.",
                    "STARTED is local date/time; agent details show seconds and UTC offset.",
                    "EXEC: background (bg) or blocking sync. MODEL: the language model used.",
                    "Approval waits are excluded by 'active'; use 'all' or '2h' to see them.",
                    "Magenta INPUT / keyboard symbol: answer needed in Copilot/VS Code.",
                    "The INPUT badge includes hidden loaded sessions/agents; 'active' excludes input waits.",
                    "AIC total sums loaded sessions once; 'known' means some session totals are missing.",
                    "Agent details: Up/Down, Page Up/Down, Home/End scroll through available telemetry.",
                    "--source cli|vscode|all selects the log source at startup.",
                    "Only recorded events are shown; status is not a process health check.",
                    "Updates: checked at startup and every eight hours; --no-update-check disables.",
                    "To install an available update: quit, run agenttop -update, then restart.",
                    notice.detail,
                ]
                for i, text in enumerate(help_lines[:max(0, height - 3)]):
                    try:
                        stdscr.addnstr(i + 2, 0, text, max(0, width - 1))
                    except curses.error:
                        pass
            elif detail is not None:
                detail_limit = render_detail(stdscr, detail, height, width, detail_scroll)
            else:
                header, body = build_display(mon, rows, now, width, tree_mode, collapsed, sessions)
                try:
                    header = pad_line(header, width - 1)
                    stdscr.addnstr(1, 0, header, len(header), curses.A_BOLD)
                except curses.error:
                    pass
                foot = footer_lines(mon, width, sessions)
                if notice.detail:
                    foot.append(clip(notice.detail, width - 1))
                top = 2
                avail = max(1, height - top - len(foot) - 1)
                cursor = max(0, min(cursor, max(0, len(body) - 1)))
                scroll = max(0, min(cursor - avail // 2, max(0, len(body) - avail)))
                if cursor < scroll:
                    scroll = cursor
                for i, item in enumerate(body[scroll:scroll + avail]):
                    kind, _obj, status, text = item
                    attr = table_row_style(kind, status, scroll + i == cursor, use_color)
                    text = pad_line(text, width - 1)
                    try:
                        stdscr.addnstr(top + i, 0, text, len(text), attr)
                    except curses.error:
                        pass
                if not body:
                    try:
                        message = ("  no logs found - use --log PATH or --cli-dir PATH"
                                   if not mon.files else "  no matching entries - a: activity, d: finished, Esc: search, f: focus")
                        stdscr.addnstr(top, 0, message,
                                       width - 1, curses.A_DIM)
                    except curses.error:
                        pass
                for j, text in enumerate(foot):
                    try:
                        attr = ((curses.color_pair(7) if use_color else 0) | curses.A_BOLD
                                if text.startswith("INPUT needed:") else curses.A_DIM)
                        stdscr.addnstr(height - 1 - len(foot) + j, 0, text, width - 1, attr)
                    except curses.error:
                        pass

            filters = filter_hint(show_done, current_activity)
            if detail is not None or show_help:
                hint = " q/esc  back  \u2191\u2193 / PgUp/PgDn scroll " if detail is not None else " q/esc  back "
            elif editing_search:
                hint = f" / {search}  [Enter: apply, Esc: clear] "
            elif search:
                hint = f" q quit {filters} search:{search}  / edit  Esc clear "
            else:
                hint = f" q quit {filters} t tree  s sort  f focus  / search  ? help  enter open  \u2191\u2193 move "
            try:
                stdscr.addnstr(height - 1, 0, (hint + STATUS_LEGEND).ljust(width), width,
                               curses.color_pair(6) if use_color else curses.A_REVERSE)
            except curses.error:
                pass
            stdscr.refresh()

            try:
                key = stdscr.get_wch()
            except curses.error:
                continue
            ch = ord(key) if isinstance(key, str) else key
            if editing_search:
                if ch in (10, 13):
                    editing_search = False
                elif ch == 27:
                    search, editing_search = "", False
                elif ch in (curses.KEY_BACKSPACE, 127, 8):
                    search = search[:-1]
                elif isinstance(key, str) and key.isprintable():
                    search += key
                cursor = 0
                continue
            if show_help:
                if ch in (ord("q"), ord("?"), 27):
                    show_help = False
                continue
            if detail is not None:
                if ch in (ord("q"), 27, curses.KEY_LEFT, ord("h"), 10):
                    detail = None
                elif ch in (curses.KEY_DOWN, ord("j"), curses.KEY_NPAGE):
                    detail_scroll = min(detail_limit, detail_scroll + (10 if ch == curses.KEY_NPAGE else 1))
                elif ch in (curses.KEY_UP, ord("k"), curses.KEY_PPAGE):
                    detail_scroll = max(0, detail_scroll - (10 if ch == curses.KEY_PPAGE else 1))
                elif ch == curses.KEY_HOME:
                    detail_scroll = 0
                elif ch == curses.KEY_END:
                    detail_scroll = detail_limit
                continue
            if ch in (ord("q"), ord("Q")):
                return
            if ch in (ord("d"), ord("D")):
                show_done = not show_done
                cursor = 0
            elif ch in (ord("a"), ord("A")):
                current_activity = activity_cycle[(activity_cycle.index(current_activity) + 1) % len(activity_cycle)]
                cursor = 0
            elif ch in (ord("s"), ord("S")):
                current_sort = sort_cycle[(sort_cycle.index(current_sort) + 1) % len(sort_cycle)]
            elif ch in (ord("r"), ord("R")):
                last_poll = 0
                mon.last_discovery = None
            elif ch == ord("/"):
                editing_search = True
            elif ch == 27:
                search = ""
                cursor = 0
            elif ch == ord("?"):
                show_help = True
            elif ch in (curses.KEY_DOWN, ord('j')):
                cursor += 1
            elif ch in (curses.KEY_UP, ord('k')):
                cursor = max(0, cursor - 1)
            elif ch == curses.KEY_NPAGE:
                cursor += 10
            elif ch == curses.KEY_PPAGE:
                cursor = max(0, cursor - 10)
            elif ch == curses.KEY_HOME:
                cursor = 0
            elif ch == curses.KEY_END:
                cursor = max(0, len(body) - 1)
            elif ch in (ord("t"), ord("T")):
                tree_mode = not tree_mode
                cursor = 0
            elif ch in (ord("f"), ord("F")):
                sessions = [s for s, _ in sorted(mon.sessions.items(),
                                                 key=lambda kv: -(kv[1].get("last_event") or 0))]
                if sessions:
                    idx = sessions.index(session_focus) + 1 if session_focus in sessions else 0
                    session_focus = sessions[idx] if idx < len(sessions) else None
                cursor = 0
            elif ch in (10, 13, curses.KEY_RIGHT, ord('l')) and body:
                kind, obj = body[min(cursor, len(body) - 1)][:2]
                if kind == "session":
                    collapsed.symmetric_difference_update({obj})
                else:
                    detail = obj
                    detail_scroll = 0
            elif ch in (curses.KEY_LEFT, ord('h')) and body:
                kind, obj = body[min(cursor, len(body) - 1)][:2]
                if kind == "session":
                    collapsed.add(obj)
                elif tree_mode:
                    collapsed.add(obj.session)
                    cursor = 0
            elif ch == ord(" ") and body:
                kind, obj = body[min(cursor, len(body) - 1)][:2]
                if kind == "session":
                    collapsed.symmetric_difference_update({obj})

    try:
        curses.wrapper(main)
    finally:
        if checker:
            checker.close()


def input_info(inputs, now):
    if not inputs:
        return {}
    started = min(info["started"] for info in inputs.values())
    return {"since": datetime.fromtimestamp(started, timezone.utc).isoformat(),
            "wait_seconds": max(0.0, now - started)}


def agent_telemetry(agent, now):
    fields = {}
    if agent.configuration:
        fields["configuration"] = dict(agent.configuration)
    if agent.model_changes:
        fields["model_changes"] = list(agent.model_changes)
    if agent.completion:
        fields["completion"] = dict(agent.completion)
    usage = dict(agent.usage_totals)
    if agent.aic is not None:
        usage.update(aic=agent.aic, aic_final=agent.final_aiu is not None)
    if agent.total_tokens is not None:
        usage["total_tokens"] = agent.total_tokens
    if usage:
        fields["usage"] = usage
    if agent.tools or agent.tool_results:
        fields["tool_stats"] = {
            "observed_calls": sum(agent.tools.values()), "results": dict(agent.tool_results),
            "timings": {name: {"samples": agent.tool_samples[name], "total_seconds": duration,
                               "average_seconds": duration / agent.tool_samples[name],
                               "max_seconds": agent.tool_max[name]}
                        for name, duration in agent.tool_durations.items()},
            "recent_results": list(agent.recent_results),
        }
    if agent.permissions or agent.permission_results:
        fields["permissions"] = {
            "pending": [{"kind": item["kind"], "started_at": fmt_timestamp(item["started"], precise=True),
                         "wait_seconds": max(0.0, now - item["started"])}
                        for item in agent.permissions.values()],
            "results": dict(agent.permission_results), "recorded_wait_seconds": agent.permission_wait,
        }
    if agent.last_error:
        fields["last_error"] = agent.last_error
    if agent.display_status == "input":
        fields["input_wait"] = input_info(agent.inputs, now)
    return fields


def detail_entries(agent, now):
    info = [
        ("agent_id", agent.agent_id), ("call_id", agent.call_id),
        ("session", agent.session), ("source", agent.source),
        ("name", agent.name), ("description", agent.description),
        ("type", agent.agent_type), ("model", agent.model),
        ("mode / status", f"{'background' if agent.mode == 'background' else 'sync'} / {agent.display_status}"),
    ]
    if agent.inputs:
        started = min(info["started"] for info in agent.inputs.values())
        info.append(("awaiting answer", f"{fmt_elapsed(max(0.0, now - started))}; answer in Copilot/VS Code"))
    if agent.permissions:
        info.append(("awaiting approval", ", ".join(
            f"{item['kind']} ({fmt_elapsed(max(0.0, now - item['started']))})"
            for item in agent.permissions.values())))
    if agent.aic is not None:
        info.append(("AIC final" if agent.final_aiu is not None else "AIC observed", f"{agent.aic:.4f}"))
    if agent.total_tokens is not None:
        info.append(("tokens total", f"{agent.total_tokens:,}"))
    for key, value in agent.usage_totals.items():
        info.append((key.replace("_", " "), f"{value:,}"))
    if agent.completion:
        info.append(("last completion", fmt_timestamp(agent.completion["at"], precise=True)))
        for key in ("total_tokens", "total_tool_calls"):
            if key in agent.completion:
                info.append(("reported " + key.removeprefix("total_"), f"{agent.completion[key]:,}"))
        if "duration_ms" in agent.completion:
            info.append(("reported duration", fmt_elapsed(agent.completion["duration_ms"] / 1000)))
    if agent.started is not None:
        info.extend([("started", fmt_timestamp(agent.started, precise=True)),
                     ("wall runtime", fmt_dur(agent.runtime(now)))])
    if agent.ended is not None:
        info.append(("ended", fmt_timestamp(agent.ended, precise=True)))
    elif agent.last_event is not None:
        info.append(("quiet since", fmt_dur(now - agent.last_event)))
    for key, value in agent.configuration.items():
        info.append((key.replace("_", " "), str(value)))
    if agent.tokens_known or agent.in_tokens or agent.out_tokens:
        info.append(("observed ctx/out", f"{agent.in_tokens:,} / {agent.out_tokens:,}"))
    if agent.cached_tokens:
        info.append(("observed cached", f"{agent.cached_tokens:,}"))
    if agent.cost:
        info.append(("premium reqs", f"{agent.cost:.2f}"))
    if agent.tools:
        info.append(("observed tools", ", ".join(f"{name} x{count}" for name, count in agent.tools.most_common())))
    if agent.tool_results:
        info.append(("tool outcomes", ", ".join(f"{name}: {count}" for name, count in agent.tool_results.items())))
    for name, maximum in agent.tool_max.most_common(10):
        info.append(("tool timing", f"{name}: max {fmt_elapsed(maximum)}, "
                     f"avg {fmt_elapsed(agent.tool_durations[name] / agent.tool_samples[name])}, "
                     f"{agent.tool_samples[name]} timed calls"))
    for call in agent.pending_tools.values():
        info.append(("tool in progress", f"{call[0]} ({fmt_elapsed(max(0.0, now - call[1]))})"))
    if agent.permission_results:
        info.extend([("last permission", agent.last_permission),
                     ("approval wait", fmt_elapsed(agent.permission_wait)),
                     ("approval results", ", ".join(f"{key}: {value}" for key, value in agent.permission_results.items()))])
    if agent.messages or agent.reads:
        info.append(("write / read", f"{agent.messages} / {agent.reads}"))
    info.append(("parent agent", agent.parent))
    info.append(("last error", agent.last_error))
    for change in agent.model_changes:
        info.append(("model change", f"{fmt_clock(change['at'])} {change.get('from', '')} -> {change['to']}"
                     + (f" ({change['cause']})" if change.get("cause") else "")))
    for result in reversed(agent.recent_results):
        text = f"{fmt_clock(result['at'])} {result.get('name', 'tool')}"
        if "success" in result:
            text += " OK" if result["success"] else " FAILED"
        if "duration_seconds" in result:
            text += f" {fmt_elapsed(result['duration_seconds'])}"
        if result.get("error"):
            text += f" - {result['error']}"
        info.append(("recent tool", text))
    info.extend([("prompt", agent.prompt), ("last result", agent.result_preview)])
    return [(key, value) for key, value in info if value is not None and value != ""]


def render_detail(stdscr, agent, height, width, scroll=0):
    import curses
    if width < 24 or height < 5:
        try:
            stdscr.addnstr(1, 0, "Resize to see details", max(0, width - 1))
        except curses.error:
            pass
        return 0
    now = time.time()
    lines = []
    for label, value in detail_entries(agent, now):
        wrapped = []
        for paragraph in str(value).splitlines():
            wrapped.extend(textwrap.wrap(paragraph, max(1, width - 22), replace_whitespace=False) or [""])
        lines.extend((label if i == 0 else "", text) for i, text in enumerate(wrapped))
    visible = max(1, height - 3)
    maximum = max(0, len(lines) - visible)
    scroll = min(maximum, max(0, scroll))
    for row, (label, text) in enumerate(lines[scroll:scroll + visible], 2):
        try:
            stdscr.addnstr(row, 2, clip(label, 18), 18, curses.A_BOLD)
            stdscr.addnstr(row, 21, text, max(1, width - 22))
        except curses.error:
            pass
    return maximum


def run_once(mon: Monitor, show_done: bool, sort_key: str, as_json: bool, tree=True, sess_filter=None, query="",
             activity="all"):
    mon.refresh()
    rows, now, sessions = mon.select(show_done, sort_key, sess_filter, query, activity)
    if as_json:
        payload = {
            "version": version(),
            "generated_at": datetime.now(timezone.utc).isoformat(),
            "logs": mon.files,
            "counts": {**dict(zip(("running", "starting", "idle", "done"), mon.counts(rows))),
                       "waiting": sum(a.display_status == "waiting" for a in rows),
                       "input": sum(a.display_status == "input" for a in rows)},
            "errors": mon.errors,
            "agents": [
                {
                    "agent_id": a.agent_id, "call_id": a.call_id, "session": a.session,
                    "parent_call_id": a.parent,
                    "name": a.name, "description": a.description, "agent_type": a.agent_type,
                    "model": a.model, "mode": a.mode, "status": a.display_status, "source": a.source,
                    "started_at": datetime.fromtimestamp(a.started, timezone.utc).isoformat() if a.started is not None else None,
                    "ended_at": datetime.fromtimestamp(a.ended, timezone.utc).isoformat() if a.ended is not None else None,
                    "runtime_seconds": round(a.runtime(now), 1),
                    "quiet_seconds": round(now - (a.last_event or now), 1) if a.ended is None else None,
                    "runtime_human": fmt_dur(a.runtime(now)),
                    "last_tool": a.last_tool, "tool_calls": dict(a.tools.most_common()),
                    "input_tokens": a.in_tokens, "output_tokens": a.out_tokens,
                    "cached_tokens": a.cached_tokens, "aiu": round(a.aiu, 4),
                    "premium_requests": round(a.cost, 3),
                    "writes": a.messages, "reads": a.reads,
                    **agent_telemetry(a, now),
                }
                for a in rows
            ],
            "sessions": {
                sid: {
                    "label": mon.session_label(sid), "repo": st.get("repo", ""),
                    "source": st["source"], "status": session_status(st), "title": st["title"],
                    "cwd": st["cwd"], "tool_calls": dict(st["tools"]),
                    "last_event_at": datetime.fromtimestamp(st["last_event"], timezone.utc).isoformat(),
                    "branch": st.get("branch", ""), "activity": st["activity"], "model": st["model"],
                    "input_tokens": st["in_tokens"], "output_tokens": st["out_tokens"],
                    "cached_tokens": st["cached_tokens"], "context_limit": st["ctx_limit"],
                    "turn_input_tokens": st["turn_in"], "turn_cached_tokens": st["turn_cached"],
                    "turn_output_tokens": st["turn_out"],
                    "turn_aiu": round(st["turn_aiu"], 4),
                    "turn_aiu_self": round(st["direct_aiu"], 4) if st["direct_aiu"] is not None else None,
                    "turn_aiu_subagents": (round(max(0.0, st["turn_aiu"] - st["direct_aiu"]), 4)
                                          if st["direct_aiu"] is not None else None),
                    "session_aiu_self": st["session_direct_aiu"],
                    "session_aiu": round(st["session_aiu"], 4),
                    "premium_quota_used_pct": st["premium_pct"],
                    **({"input_wait": input_info(st["inputs"], now)} if session_status(st) == "input" else {}),
                }
                for sid, st in mon.sessions.items() if sid in sessions
            },
        }
        total, complete = mon.aic_total()
        if total is not None:
            payload["totals"] = {"aic": total, "complete": complete, "scope": "loaded_sessions"}
        input_agents, input_sessions = mon.input_attention()
        payload["attention"] = {"input_agents": input_agents, "input_sessions": input_sessions,
                                "scope": "loaded_sessions"}
        json.dump(payload, sys.stdout, indent=2)
        print()
        return
    width = min(200, shutil.get_terminal_size((120, 24)).columns)
    running, starting, idle, done = mon.counts(rows)
    total = aic_summary(mon)
    waiting = sum(a.display_status == "waiting" for a in rows)
    input_agents, input_sessions = mon.input_attention()
    attention = f" | INPUT {input_agents + input_sessions}" if input_agents or input_sessions else ""
    print(f"agenttop {version()}{attention}{' | ' + total if total else ''}"
          f"  running {running}  starting {starting}  idle {idle}  done {done}  waiting {waiting}"
          f"  | sessions {len(sessions)}  logs {len(mon.files)}"
          f"  | activity:{ACTIVITY_FILTERS[activity]} finished:{'show' if show_done else 'hide'}")
    header, body = build_display(mon, rows, now, width, tree, set(), sessions)
    print(header)
    for _kind, _obj, _status, text in body:
        print(text)
    if not body:
        print("  no matching entries" if mon.files else "  no logs found - use --log PATH or --cli-dir PATH")
    for line in footer_lines(mon, width, sessions):
        print(line)


def positive_float(value):
    number = float(value)
    if not math.isfinite(number) or number <= 0:
        raise argparse.ArgumentTypeError("must be a finite number greater than zero")
    return number


def main(argv=None):
    ap = argparse.ArgumentParser(description="htop-style monitor for Copilot CLI and VS Code sessions")
    ap.add_argument("--version", action="version", version=f"agenttop {version()}")
    ap.add_argument("-update", "--update", action="store_true",
                    help="update this Git installation from origin/main (fast-forward only), then exit")
    ap.add_argument("--no-update-check", action="store_true",
                    help="disable the TUI background update check (normally at startup and every 8 hours)")
    ap.add_argument("--log", action="append", metavar="PATH",
                    help="AHP log, CLI events.jsonl, or directory (repeatable); default: auto-discover both")
    ap.add_argument("--source", choices=["all", "cli", "vscode"], default="all", help="log sources to read (default: all)")
    ap.add_argument("--cli-dir", metavar="PATH", help="Copilot session-state directory (default: ~/.copilot/session-state)")
    ap.add_argument("--search", default="", metavar="TEXT", help="filter by session, task, agent or model")
    ap.add_argument("--interval", type=positive_float, default=1.0, help="poll interval in seconds (default 1.0)")
    ap.add_argument("--max-age", type=positive_float, default=24.0,
                    help="only auto-discover logs modified within N hours (default 24)")
    finished = ap.add_mutually_exclusive_group()
    finished.add_argument("--all-done", dest="show_done", action="store_true",
                          help="include done, failed and cancelled agents/sessions (default for JSON)")
    finished.add_argument("--hide-done", dest="show_done", action="store_false",
                          help="hide finished agents/sessions, including in JSON (default for TUI/text)")
    ap.set_defaults(show_done=None)
    ap.add_argument("--activity", choices=tuple(ACTIVITY_FILTERS), default="all",
                    help="all: no activity restriction; active: running/starting; recent: last event within 2h")
    ap.add_argument("--sort", default="runtime", choices=["runtime", "start", "idle", "status", "name"])
    ap.add_argument("--flat", action="store_true", help="flat list instead of the session tree")
    ap.add_argument("--session", metavar="ID", help="only show this session (id prefix)")
    ap.add_argument("--once", action="store_true", help="print one snapshot and exit")
    ap.add_argument("--json", action="store_true", help="print one snapshot as JSON and exit")
    args = ap.parse_args(argv)

    if args.update:
        if len(sys.argv[1:] if argv is None else argv) != 1:
            ap.error("--update must be used on its own")
        return update_checkout()

    mon = Monitor(targets=args.log, max_age_h=args.max_age, source=args.source, cli_dir=args.cli_dir)
    show_done = args.json if args.show_done is None else args.show_done
    if args.once or args.json or not sys.stdout.isatty():
        run_once(mon, show_done, args.sort, args.json,
                 tree=not args.flat, sess_filter=args.session, query=args.search, activity=args.activity)
        return 0
    try:
        run_tui(mon, args.interval, tree=not args.flat, sess_filter=args.session,
                all_done=show_done, sort_key=args.sort, query=args.search,
                check_updates=not args.no_update_check, activity=args.activity)
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
