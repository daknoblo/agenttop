def git_output(root, *args, timeout=10):
    return subprocess.run(
        ["git", "-C", root, *args], check=True, capture_output=True,
        text=True, timeout=timeout,
    ).stdout.strip()


@lru_cache(maxsize=1)
def version():
    """Identify the loaded checkout once, not the changing checkout during a TUI run."""
    path = os.path.realpath(__file__)
    root = os.path.dirname(path)
    if os.path.exists(os.path.join(root, ".git")):
        def git(*args):
            return git_output(root, *args, timeout=3)

        try:
            count = git("rev-list", "--count", "HEAD")
            commit = git("rev-parse", "--short=8", "HEAD")
            shallow = git("rev-parse", "--is-shallow-repository") == "true"
            dirty = bool(git("status", "--porcelain", "--untracked-files=normal"))
        except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
            return "unknown (Git unavailable)"
        return f"r{count}.{commit}{'-shallow' if shallow else ''}{'-dirty' if dirty else ''}"
    try:
        with open(path, "rb") as source:
            digest = hashlib.sha256(source.read()).hexdigest()[:12]
    except OSError:
        return "unknown (source unavailable)"
    return f"unversioned.{digest}"


class UpdateError(Exception):
    pass


def update_checkout():
    """Update the installed checkout, never the caller's working directory."""
    source = os.path.realpath(__file__)
    root = os.path.dirname(source)

    def require_clean():
        if git_output(root, "status", "--porcelain", "--untracked-files=normal",
                      "--ignore-submodules=none"):
            raise UpdateError(
                "Local changes or untracked files found. Save your work and make the "
                "checkout clean before updating; nothing will be reset or stashed."
            )
        if git_output(root, "symbolic-ref", "--quiet", "--short", "HEAD") != "main":
            raise UpdateError("Updates require branch main. Switch branches manually after saving your work.")
        for name in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD",
                     "rebase-merge", "rebase-apply", "sequencer", "BISECT_START"):
            path = git_output(root, "rev-parse", "--git-path", name)
            if os.path.exists(os.path.join(root, path)):
                raise UpdateError("A Git operation is in progress. Finish or abort it manually before updating.")

    stage = "Checking installation"
    try:
        if not os.path.exists(os.path.join(root, ".git")):
            raise UpdateError(
                "This installation has no Git metadata. Install a main-branch Git checkout "
                "as described in docs/installation.md; standalone copies cannot self-update."
            )
        if os.path.realpath(git_output(root, "rev-parse", "--show-toplevel")) != root:
            raise UpdateError("The executable is not at the Git checkout root; update manually.")
        git_output(root, "ls-files", "--error-unmatch", "--", os.path.basename(source))
        if git_output(root, "rev-parse", "--is-shallow-repository") == "true":
            raise UpdateError(
                "Shallow history cannot establish a safe update. Fetch complete history "
                "manually or use a full clone before retrying."
            )
        if git_output(root, "rev-parse", "--abbrev-ref", "HEAD") == "HEAD":
            raise UpdateError("Detached HEAD detected. Switch to main manually before updating.")
        require_clean()
        before = git_output(root, "rev-parse", "HEAD")
        stage = "Fetching origin/main"
        print("Fetching origin/main...", flush=True)
        git_output(root, "fetch", "--no-tags", "--no-recurse-submodules", "origin",
                   "+refs/heads/main:refs/remotes/origin/main", timeout=120)
        target = git_output(root, "rev-parse", "refs/remotes/origin/main")
        stage = "Checking fast-forward"
        require_clean()
        if git_output(root, "rev-parse", "HEAD") != before:
            raise UpdateError("The checkout changed during the fetch. Retry after other Git operations finish.")
        if target == before:
            version.cache_clear()
            print(f"Already up to date: agenttop {version()}")
            return 0
        try:
            git_output(root, "merge-base", "--is-ancestor", before, target)
        except subprocess.CalledProcessError as exc:
            if exc.returncode != 1:
                raise
            raise UpdateError(
                "origin/main is not a fast-forward of this checkout (local commits or "
                "rewritten history). Update stopped. Preserve your installation and "
                "follow the fresh-clone instructions; no reset or reinstall was performed."
            ) from exc
        git_output(root, "cat-file", "-e", f"{target}:{os.path.basename(source)}")
        stage = "Applying fast-forward"
        git_output(root, "-c", "merge.autoStash=false", "merge", "--ff-only",
                   "--no-autostash", "--no-overwrite-ignore", "--no-edit", target, timeout=120)
        if git_output(root, "rev-parse", "HEAD") != target:
            raise UpdateError("Unexpected HEAD after updating. Inspect the checkout before running agenttop.")
        version.cache_clear()
        print(f"Updated {before[:8]} -> {target[:8]}: agenttop {version()}")
        print("Start agenttop again to run the new version; restart other running monitors too.")
        return 0
    except UpdateError as exc:
        print(f"Update stopped: {exc}", file=sys.stderr)
    except subprocess.TimeoutExpired:
        print(f"Update stopped: {stage} timed out. Check Git status and network/authentication before retrying.",
              file=sys.stderr)
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "").strip()
        print(f"Update stopped: {stage} failed (Git exit {exc.returncode})."
              f"{' ' + detail if detail else ''}", file=sys.stderr)
    except OSError as exc:
        print(f"Update stopped: {stage}: {exc}", file=sys.stderr)
    return 1


UPDATE_CHECK_INTERVAL = 8 * 60 * 60
UpdateNotice = collections.namedtuple("UpdateNotice", "status text detail")


def check_update(root, git, loaded_revision=""):
    """Compare ancestry, not just hashes: local-only commits are not updates."""
    try:
        if not os.path.exists(os.path.join(root, ".git")):
            return UpdateNotice("unavailable", "Updates: unavailable", "Update checks require a Git checkout.")
        if os.path.realpath(git("rev-parse", "--show-toplevel")) != os.path.realpath(root):
            return UpdateNotice("unavailable", "Updates: unavailable", "The executable must be at the checkout root.")
        if git("rev-parse", "--abbrev-ref", "HEAD") != "main":
            return UpdateNotice("unavailable", "Updates: not on main", "Switch to main manually to check for updates.")
        if git("rev-parse", "--is-shallow-repository") == "true":
            return UpdateNotice("unavailable", "Updates: shallow clone", "A full-history clone is required for update checks.")
        before = git("rev-parse", "HEAD")
        if loaded_revision and not before.startswith(loaded_revision):
            return UpdateNotice("restart", "Restart agenttop", "The checkout changed since this monitor started.")
        git("fetch", "--no-tags", "--no-recurse-submodules", "origin",
            "+refs/heads/main:refs/remotes/origin/main")
        target = git("rev-parse", "refs/remotes/origin/main")
        if git("rev-parse", "HEAD") != before:
            return UpdateNotice("restart", "Restart agenttop", "The checkout changed during the update check.")
        if before == target:
            return UpdateNotice("current", "Up to date", "")

        def ancestor(left, right):
            try:
                git("merge-base", "--is-ancestor", left, right)
                return True
            except subprocess.CalledProcessError as exc:
                if exc.returncode != 1:
                    raise
                return False

        if ancestor(before, target):
            revision = f"r{git('rev-list', '--count', target)}.{target[:8]}"
            detail = f"{revision} available. Quit and run agenttop -update, then restart."
            if git("status", "--porcelain", "--untracked-files=normal", "--ignore-submodules=none"):
                detail += " Save local changes and clean the checkout first."
            return UpdateNotice("available", "Update: agenttop -update", detail)
        if ancestor(target, before):
            return UpdateNotice("ahead", "Local commits ahead", "No fast-forward update: this checkout has local-only commits.")
        return UpdateNotice("diverged", "History differs", "origin/main has diverged or was rewritten; a manual update is required.")
    except subprocess.TimeoutExpired:
        return UpdateNotice("error", "Update check failed", "Update check timed out; retrying in eight hours.")
    except subprocess.CalledProcessError as exc:
        return UpdateNotice("error", "Update check failed",
                            f"Git exited with code {exc.returncode}. Check origin, network and Git authentication; retrying in eight hours.")
    except OSError as exc:
        return UpdateNotice("error", "Update check failed", f"Git could not run ({type(exc).__name__}); retrying in eight hours.")


class CheckCancelled(Exception):
    pass


class UpdateChecker:
    def __init__(self, root=None):
        self.root = root or os.path.dirname(os.path.realpath(__file__))
        match = re.match(r"r\d+\.([0-9a-f]+)", version())
        self.loaded_revision = match.group(1) if match else ""
        self.notice = UpdateNotice("checking", "Checking updates...", "")
        self.next_check = 0.0
        self.results = queue.SimpleQueue()
        self.thread = None
        self.stopped = threading.Event()
        self.process_lock = threading.Lock()
        self.process = None

    @staticmethod
    def terminate(process):
        try:
            if os.name == "posix":
                # Git can exit before helpers that still own its output pipes.
                os.killpg(process.pid, signal.SIGKILL)
            elif process.poll() is None:
                process.kill()
        except ProcessLookupError:
            pass

    def git(self, *args):
        env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GCM_INTERACTIVE="never",
                   SSH_ASKPASS_REQUIRE="never")
        with self.process_lock:
            if self.stopped.is_set():
                raise CheckCancelled()
            process = subprocess.Popen(
                ["git", "-C", self.root, "-c", "credential.interactive=false",
                 "-c", "core.askPass=", *args],
                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                text=True, env=env, start_new_session=True,
            )
            self.process = process
        try:
            try:
                output, error = process.communicate(timeout=30 if args[0] == "fetch" else 5)
            except subprocess.TimeoutExpired:
                self.terminate(process)
                try:
                    process.communicate(timeout=1)
                except subprocess.TimeoutExpired:
                    process.stdout.close()
                    process.stderr.close()
                raise
            if self.stopped.is_set():
                raise CheckCancelled()
            if process.returncode:
                raise subprocess.CalledProcessError(process.returncode, process.args, output, error)
            return output.strip()
        finally:
            with self.process_lock:
                self.process = None

    def work(self):
        try:
            notice = check_update(self.root, self.git, self.loaded_revision)
        except CheckCancelled:
            return
        self.results.put(notice)

    def poll(self):
        while True:
            try:
                self.notice = self.results.get_nowait()
            except queue.Empty:
                break
        now = time.monotonic()
        if (not self.stopped.is_set() and now >= self.next_check
                and (self.thread is None or not self.thread.is_alive())):
            self.next_check = now + UPDATE_CHECK_INTERVAL
            self.thread = threading.Thread(target=self.work, name="agenttop-update-check", daemon=True)
            self.thread.start()
        return self.notice

    def close(self):
        self.stopped.set()
        with self.process_lock:
            if self.process is not None:
                self.terminate(self.process)
        if self.thread is not None:
            self.thread.join(timeout=1)


