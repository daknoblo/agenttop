STATUS_GLYPH = {"running": "\u25cf", "starting": "\u25cb", "idle": "\u25cc", "waiting": "\u23f8", "input": "\u2328",
                "done": "\u2713", "failed": "\u2717", "cancelled": "\u2298", "orphan": "?", "unknown": "?"}
STATUS_ORDER = {status: i for i, status in enumerate(("input", "waiting", "running", "starting", "idle", "failed", "cancelled", "done", "orphan"))}
STATUS_LEGEND = " \u2328 input  \u23f8 approval  \u25cf running  \u25cb starting  \u25cc idle  \u2713 done  \u2717 failed  \u2298 cancelled  ? unknown "
SOURCE_GLYPH = {"cli": ">_", "vscode": "\u25c7"}


def fmt_dur(seconds: float) -> str:
    """Human readable duration: 45s / 12m 34s / 3h 05m / 1d 21h."""
    seconds = int(max(0, seconds))
    if seconds < 60:
        return f"{seconds}s"
    minutes, sec = divmod(seconds, 60)
    if minutes < 60:
        return f"{minutes}m {sec:02d}s"
    hours, minutes = divmod(minutes, 60)
    if hours < 24:
        return f"{hours}h {minutes:02d}m"
    days, hours = divmod(hours, 24)
    return f"{days}d {hours:02d}h"


def nano_to_aiu(nano) -> float:
    return (nano or 0) / 1e9


def fmt_aiu(value: float) -> str:
    if not value:
        return "-"
    if value >= 1000:
        return f"{value / 1000:.1f}k"
    if value >= 10:
        return f"{value:.0f}"
    return f"{value:.2f}"


def fmt_aic(value):
    if value is None:
        return ""
    if value == 0:
        return "0"
    if value >= 1_000_000:
        return f"{value / 1_000_000:.2f}M"
    if value >= 1000:
        return f"{value / 1000:.2f}k"
    if value < 0.0001:
        return "<0.0001"
    return f"{value:.4f}" if value < 1 else f"{value:.2f}"


def fmt_elapsed(seconds):
    return f"{seconds * 1000:.0f}ms" if seconds < 1 else (f"{seconds:.2f}s" if seconds < 60 else fmt_dur(seconds))


def aic_summary(mon):
    total, complete = mon.aic_total()
    return f"AIC {'total' if complete else 'known'} {fmt_aic(total)}" if total is not None else ""


def fmt_tokens(n: int) -> str:
    if not n:
        return "-"
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1000:
        return f"{n // 1000}k"
    return str(n)


def fmt_clock(ts) -> str:
    return datetime.fromtimestamp(ts).strftime("%H:%M:%S") if ts else "-"


def fmt_timestamp(ts, precise=False) -> str:
    if ts is None:
        return "-"
    local = datetime.fromtimestamp(ts).astimezone()
    return local.isoformat(sep=" ", timespec="seconds") if precise else local.strftime("%Y-%m-%d %H:%M")


@lru_cache(maxsize=4096)
def cell_width(char):
    if unicodedata.category(char) in ("Mn", "Me", "Cf"):
        return 0
    return 2 if unicodedata.east_asian_width(char) in ("W", "F") else 1


def text_width(text):
    return sum(cell_width(char) for char in text)


def slice_cells(text, width):
    if width <= 0:
        return ""
    used = 0
    result = []
    for char in text:
        size = cell_width(char)
        if used + size > max(0, width):
            break
        result.append(char)
        used += size
    return "".join(result)


def clip(text: str, width: int) -> str:
    text = " ".join((text or "").split())
    text = "".join(char for char in text if unicodedata.category(char) != "Cc")
    if width <= 0:
        return ""
    return text if text_width(text) <= width else slice_cells(text, width - 1) + "\u2026"


def fit_cell(text, width, right=False):
    text = clip(text, width)
    padding = " " * max(0, width - text_width(text))
    return padding + text if right else text + padding


def pad_line(text, width):
    text = slice_cells(text, width)
    return text + " " * max(0, width - text_width(text))


COLS = {"status": 2, "started": 16, "rt": 9, "quiet": 8, "id": 8, "type": 15, "mode": 4, "tools": 13, "model": 16,
        "tok": 12, "aiu": 7}
COLUMN_LABELS = {"status": "S", "started": "STARTED (local)", "rt": "RUNTIME", "quiet": "QUIET",
                 "id": "AGENT", "type": "TYPE", "mode": "EXEC", "model": "MODEL", "tools": "TOOLS",
                 "tok": "TOKENS", "aiu": "AIC", "task": "TASK"}
RIGHT_ALIGNED = {"rt", "quiet", "tok", "aiu"}
COLUMN_SEPARATOR = " \u2502 "
WIDE_AT = 132                                       # show TOKENS/AIC columns from here
MODEL_AT = 160


def table_layout(width):
    widths = dict(COLS)
    if width >= 200:
        widths.update(rt=10, quiet=9, type=18, mode=10, model=28, tools=20, tok=14, aiu=10)
    columns = ["status", "started", "rt", "quiet", "id", "type", "mode"]
    if width >= MODEL_AT:
        columns.append("model")
    columns.append("tools")
    if width >= WIDE_AT:
        columns.extend(("tok", "aiu"))
    for optional in ("tools", "mode", "quiet", "type", "id", "rt", "started"):
        if sum(widths[key] + len(COLUMN_SEPARATOR) for key in columns) <= max(0, width - 1 - 16):
            break
        if optional in columns:
            columns.remove(optional)
    widths["task"] = max(0, width - 1 - sum(widths[key] + len(COLUMN_SEPARATOR) for key in columns))
    return [columns[0], "task", *columns[1:]], widths


def column_widths(width):
    return table_layout(width)[1]


def table_columns(width):
    return table_layout(width)[0]


def format_columns(values, width, task_prefix=""):
    columns, widths = table_layout(width)
    cells = []
    for key in columns:
        if key == "task":
            prefix = slice_cells(task_prefix, widths[key])
            task = prefix + clip(values.get(key, ""), max(0, widths[key] - text_width(prefix)))
            cells.append(pad_line(task, widths[key]))
        else:
            cells.append(fit_cell(values.get(key, ""), widths[key], key in RIGHT_ALIGNED))
    return COLUMN_SEPARATOR.join(cells)


def table_header(width):
    return slice_cells(format_columns(COLUMN_LABELS, width), max(0, width - 1))


def agent_line(a, now, width, prefix=""):
    status = a.display_status
    quiet = fmt_dur(now - (a.last_event or now)) if a.ended is None else "-"
    mode = ("background" if column_widths(width)["mode"] >= 10 else "bg") if a.mode == "background" else "sync"
    if a.total_tokens is not None:
        tok = f"sum {fmt_tokens(a.total_tokens) if a.total_tokens else '0'}"
    else:
        tok = f"{a.in_tokens}/{a.out_tokens}" if a.tokens_known else ""
        if a.in_tokens or a.out_tokens:
            tok = f"{fmt_tokens(a.in_tokens)}/{fmt_tokens(a.out_tokens)}"
    values = {"status": STATUS_GLYPH.get(status, "?"), "started": fmt_timestamp(a.started),
              "rt": fmt_dur(a.runtime(now)), "quiet": quiet, "id": a.short_id,
              "type": a.agent_type, "mode": mode, "model": a.model, "tools": a.tool_summary,
              "tok": tok, "aiu": fmt_aic(a.aic)}
    values["task"] = ({"waiting": "[approval] ", "input": "[INPUT] "}.get(status, "")) + a.label
    return status, slice_cells(format_columns(values, width, prefix), max(0, width - 1))


def build_rows(mon: Monitor, rows, now, width):
    """Flat listing (kept for the plain --flat rendering)."""
    return table_header(width), [agent_line(a, now, width) for a in rows]


def session_header(mon: Monitor, sid, kids, now, collapsed, width):
    st = mon.sessions.get(sid, {})
    mark = "\u25bc" if sid not in collapsed else "\u25b6"
    status = session_status(st) if st else "unknown"
    counts = collections.Counter(k.display_status for k in kids if k.ended is None)
    inputs = counts["input"] + (status == "input")
    approvals = counts["waiting"] + (status == "waiting")
    summary = []
    if inputs:
        summary.append(f"{inputs} INPUT")
    if approvals:
        summary.append(f"{approvals} approval")
    if kids:
        summary.append(f"{counts['running'] + counts['starting']} active")
        if counts["idle"]:
            summary.append(f"{counts['idle']} idle")
        finished = sum(k.ended is not None for k in kids)
        if finished:
            summary.append(f"{finished} finished")
        unknown = sum(value for key, value in counts.items()
                      if key not in ("running", "starting", "idle", "input", "waiting"))
        if unknown:
            summary.append(f"{unknown} unknown")
    elif not summary:
        summary.append(status)

    available = max(0, width - 1)
    cost_width = 14 if width >= 200 else (12 if width >= 80 else 0)
    space = max(0, available - cost_width - len(COLUMN_SEPARATOR) * (2 if cost_width else 1))
    identity_min = 44 if width >= 120 else 32
    summary_min = min(12, max(0, space - 5))
    identity_width = min(max(identity_min, column_widths(width)["task"] + 5),
                         max(0, space - summary_min))
    summary_width = max(0, space - identity_width)
    source = SOURCE_GLYPH.get(st.get("source", "vscode"), "?")
    short_id = f" [{fit_cell(sid[:8], 8)}]" if identity_width >= 28 else ""
    name_width = max(0, identity_width - 5 - text_width(short_id))
    identity = f"{mark} {fit_cell(source, 2)} {fit_cell(mon.session_label(sid), name_width)}{short_id}"
    parts = [pad_line(identity, identity_width), fit_cell(" \u00b7 ".join(summary), summary_width)]
    if cost_width:
        cost = ("AIC " + fit_cell(fmt_aic(st.get("session_aiu", 0)), cost_width - 4, right=True)
                if st.get("session_aiu_known") or st.get("session_aiu") else " " * cost_width)
        parts.append(cost)
    return slice_cells(COLUMN_SEPARATOR.join(parts), available)


def usage_lines(mon: Monitor, width, sessions=None):
    """Per-session token/AIU accounting, the bottom panel of the TUI."""
    candidates = [(sid, st) for sid, st in mon.sessions.items()
                  if (sessions is None or sid in sessions)
                  and (st["in_tokens"] or st["session_aiu"] or st.get("session_aiu_known"))]
    candidates.sort(key=lambda kv: -kv[1]["last_event"])
    out = []
    for sid, st in candidates[:3]:
        ctx = f"ctx {fmt_tokens(st['in_tokens'])}" if st["in_tokens"] else ""
        if st.get("ctx_limit"):
            ctx += f"/{fmt_tokens(st['ctx_limit'])}"
        if st.get("cached_tokens"):
            ctx += f" ({fmt_tokens(st['cached_tokens'])} cached)"
        turn_tok = ""
        if st.get("turn_in"):
            turn_tok = (f"  turn {fmt_tokens(st['turn_in'])} in"
                        f" / {fmt_tokens(st['turn_out'])} out")
        aiu = f"  AIC turn {fmt_aic(st['turn_aiu'])}" if st.get("turn_aiu_known") or st["turn_aiu"] else ""
        agents_aiu = st["turn_aiu"] - st["direct_aiu"] if st["direct_aiu"] is not None else None
        if st["direct_aiu"] and agents_aiu is not None and agents_aiu > 0.005:
            aiu += f" (self {fmt_aic(st['direct_aiu'])} + agents {fmt_aic(agents_aiu)})"
        if st.get("session_aiu_known") or st["session_aiu"]:
            aiu += f"  AIC session {fmt_aic(st['session_aiu'])}"
        quota = f"  premium {st['premium_pct']:.1f}% used" if st.get("premium_pct") is not None else ""
        out.append(clip(f"{sid[:8]} {st['model'] or '-'}  {ctx}{turn_tok}{aiu}{quota}", width))
    return out


def footer_lines(mon: Monitor, width, sessions=None):
    lines = usage_lines(mon, width, sessions)
    input_agents, input_sessions = mon.input_attention()
    if input_agents or input_sessions:
        lines.insert(0, clip(f"INPUT needed: {input_sessions} sessions, {input_agents} agents. "
                             "Answer in Copilot/VS Code; a:all reveals filtered entries.", width))
    if mon.errors:
        lines.append(clip(f"Warning ({len(mon.errors)}): {mon.errors[-1]}", width))
    return lines


def build_display(mon: Monitor, rows, now, width, tree, collapsed, sessions=None):
    """Return (header, items); each item is (kind, obj, status, text)."""
    header = table_header(width)
    if not tree:
        return header, [("agent", a) + agent_line(a, now, width) for a in rows]

    visible = {a.call_id for a in rows}
    grouped = {sid: [] for sid in sessions} if sessions is not None else {}
    for a in rows:
        grouped.setdefault(a.session, []).append(a)
    order = sorted(grouped, key=lambda s: -(mon.sessions.get(s, {}).get("last_event") or 0))

    items = []
    for sid in order:
        kids = grouped[sid]
        state = mon.sessions.get(sid)
        status = session_status(state) if state else "unknown"
        if any(k.display_status == "input" for k in kids):
            status = "input"
        items.append(("session", sid, status, session_header(mon, sid, kids, now, collapsed, width)))
        if sid in collapsed:
            continue
        children = {}
        roots = []
        for a in kids:
            if a.parent and a.parent in visible:
                children.setdefault(a.parent, []).append(a)
            else:
                roots.append(a)

        def emit(node, stem, last):
            branch = ("\u2514\u2500 " if last else "\u251c\u2500 ") if stem is not None else ""
            prefix = (stem or "") + branch
            items.append(("agent", node) + agent_line(node, now, width, prefix))
            subs = children.get(node.call_id, [])
            next_stem = (stem or "") + ("   " if last else "\u2502  ")
            for i, sub in enumerate(subs):
                emit(sub, next_stem, i == len(subs) - 1)

        for i, root in enumerate(roots):
            emit(root, "", i == len(roots) - 1)
    return header, items


