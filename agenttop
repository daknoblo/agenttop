LOG_GLOBS = [
    "~/Library/Application Support/Code*/logs/*/ahp/*.jsonl",
    "~/.config/Code*/logs/*/ahp/*.jsonl",
    "~/AppData/Roaming/Code*/logs/*/ahp/*.jsonl",
]
CLI_GLOB = "~/.copilot/session-state/*/events.jsonl"

# cheap prefilter: lines that can never carry state we care about
SKIP_TOKENS = ('"chat/toolCallDelta"', '"chat/delta"', '"terminal/data"', '"method":"ping"')
KEEP_TOKENS = (
    "toolCallStart",
    "toolCallReady",
    "toolCallComplete",
    "systemNotification",
    "activityChanged",
    "chat/usage",
    "turnStarted",
    "turnComplete",
    "metaChanged",
    "sessionSummaryChanged",
    "chatAdded",
)
CLI_EVENTS = (
    "session.start", "session.resume", "session.shutdown", "session.model_change",
    "session.usage_checkpoint", "session.error", "session.task_complete",
    "user.message", "assistant.message", "assistant.turn_start", "assistant.turn_end",
    "tool.execution_start", "tool.execution_complete", "subagent.started",
    "subagent.completed", "subagent.failed", "system.notification", "abort",
    "model.model_call_success",
)

AGENT_ID_RE = re.compile(r"agent_id:?\s*`?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})")
BG_DONE_RE = re.compile(r"[Bb]ackground agent ([0-9a-f-]{36}) is (?:completed|complete|done)")
DESC_DONE_RE = re.compile(r"^`(.+?)`\s+(?:completed|is complete)", re.S)

# a `task` call that never produced launch args or a result within this window is an orphan
# (its remaining events were lost to AHP log rotation)
ORPHAN_AFTER = 120.0
RECENT_ACTIVITY_SECONDS = 2 * 60 * 60
ACTIVITY_FILTERS = {"all": "all", "active": "active", "recent": "2h"}


def discover_logs(max_age_h: float, patterns=None) -> list[str]:
    cutoff = time.time() - max_age_h * 3600
    found = []
    for pattern in LOG_GLOBS if patterns is None else patterns:
        for path in glob.glob(os.path.expanduser(pattern)):
            try:
                if os.path.getmtime(path) >= cutoff:
                    found.append(path)
            except OSError:
                pass
    return sorted(set(found))


def expand_target(target: str) -> list[str]:
    target = os.path.expanduser(target)
    if os.path.isdir(target):
        hits = glob.glob(os.path.join(target, "**", "ahp-*.jsonl"), recursive=True)
        hits += glob.glob(os.path.join(target, "**", "events.jsonl"), recursive=True)
        return sorted(hits) or sorted(glob.glob(os.path.join(target, "**", "*.jsonl"), recursive=True))
    return [target]


