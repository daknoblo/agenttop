def parse_ts(value):
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def session_of(channel: str) -> str:
    """ahp-chat://default/<base64 of copilotcli:/uuid> -> readable session id."""
    if not channel:
        return "?"
    tail = channel.split("/")[-1]
    try:
        pad = tail + "=" * (-len(tail) % 4)
        decoded = base64.urlsafe_b64decode(pad).decode("utf-8", "replace")
        if decoded.startswith("copilotcli:"):
            return decoded.rsplit("/", 1)[-1]
    except Exception:
        pass
    return tail


def text_of(result) -> str:
    if not isinstance(result, dict):
        return ""
    out = []
    for part in result.get("content") or []:
        if isinstance(part, dict) and part.get("type") == "text":
            out.append(part.get("text") or "")
    return "\n".join(out)


def is_metric(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) and value >= 0


def session_status(state):
    if state.get("inputs") and state["status"] not in ("done", "failed", "cancelled"):
        return "input"
    if state.get("permissions") and state["status"] not in ("done", "failed", "cancelled"):
        return "waiting"
    return state["status"]


class Agent:
    __slots__ = (
        "call_id", "agent_id", "session", "name", "description", "agent_type", "model",
        "mode", "prompt", "started", "ended", "status", "last_tool", "last_event",
        "messages", "reads", "result_preview", "launched", "parent",
        "tools", "tool_log", "in_tokens", "out_tokens", "cached_tokens", "cost", "aiu",
        "source",
        "resumable",
        "configuration", "model_changes", "completion", "usage_totals", "final_aiu", "aiu_known",
        "pending_tools", "completed_tools", "tool_results", "tool_durations", "tool_samples",
        "recent_results", "last_error", "permissions", "permission_results", "permission_wait", "tool_max",
        "last_permission", "tokens_known", "native_terminal", "inputs",
    )

    def __init__(self, call_id, session, started, parent=None):
        self.call_id = call_id
        self.agent_id = None
        self.session = session
        self.name = ""
        self.description = ""
        self.agent_type = ""
        self.model = ""
        self.mode = "sync"
        self.prompt = ""
        self.started = started
        self.ended = None
        self.status = "starting"
        self.last_tool = ""
        self.last_event = started
        self.messages = 0
        self.reads = 0
        self.result_preview = ""
        self.launched = False
        self.parent = parent
        self.tools = collections.Counter()
        self.tool_log = collections.deque(maxlen=12)
        self.in_tokens = 0
        self.out_tokens = 0
        self.cached_tokens = 0
        self.cost = 0.0
        self.aiu = 0.0
        self.source = "vscode"
        self.resumable = True
        self.configuration = {}
        self.model_changes = collections.deque(maxlen=10)
        self.completion = {}
        self.usage_totals = {}
        self.final_aiu = None
        self.aiu_known = False
        self.tokens_known = False
        self.pending_tools = {}
        self.completed_tools = set()
        self.tool_results = collections.Counter()
        self.tool_durations = collections.Counter()
        self.tool_samples = collections.Counter()
        self.tool_max = collections.Counter()
        self.recent_results = collections.deque(maxlen=12)
        self.last_error = ""
        self.permissions = {}
        self.permission_results = collections.Counter()
        self.permission_wait = 0.0
        self.last_permission = ""
        self.native_terminal = False
        self.inputs = {}

    @property
    def display_status(self):
        if self.inputs and self.ended is None:
            return "input"
        return "waiting" if self.permissions and self.ended is None else self.status

    @property
    def aic(self):
        if self.final_aiu is not None:
            return self.final_aiu
        return self.aiu if self.aiu_known or self.aiu else None

    @property
    def total_tokens(self):
        if "input_tokens" in self.usage_totals and "output_tokens" in self.usage_totals:
            return self.usage_totals["input_tokens"] + self.usage_totals["output_tokens"]
        return self.completion.get("total_tokens")

    def tool_started(self, call, name, ts):
        if call and (call in self.pending_tools or call in self.completed_tools):
            return
        self.last_tool = name
        self.tools[name] += 1
        self.tool_log.append((ts, name))
        if call:
            self.pending_tools[call] = (name, ts)

    def tool_completed(self, call, ts, success=None, error=""):
        if not call or call in self.completed_tools:
            return
        self.completed_tools.add(call)
        started = self.pending_tools.pop(call, None)
        result = {"at": ts}
        if started:
            name, when = started
            duration = max(0.0, ts - when)
            self.tool_durations[name] += duration
            self.tool_samples[name] += 1
            self.tool_max[name] = max(self.tool_max[name], duration)
            result.update(name=name, duration_seconds=duration)
        if isinstance(success, bool):
            result["success"] = success
            self.tool_results["success" if success else "failed"] += 1
        if error:
            result["error"] = str(error)[:1000]
            if success is False and not self.native_terminal:
                self.last_error = result["error"]
        self.recent_results.append(result)

    def model_changed(self, data, ts):
        model = data.get("newModel")
        if model:
            change = {"to": model, "at": ts}
            previous = data.get("previousModel") or self.model
            if previous:
                change["from"] = previous
            if data.get("cause"):
                change["cause"] = data["cause"]
            self.model_changes.append(change)
            self.model = model
        for raw, name in (("reasoningEffort", "reasoning_effort"), ("contextTier", "context_tier")):
            if data.get(raw):
                self.configuration[name] = data[raw]

    def reported_completion(self, data, ts):
        self.completion = {"at": ts}
        for raw, name in (("durationMs", "duration_ms"), ("totalTokens", "total_tokens"),
                          ("totalToolCalls", "total_tool_calls")):
            if is_metric(data.get(raw)):
                self.completion[name] = data[raw]
        for raw, name in (("configuredModelPreference", "preferred_model"),
                          ("explicitModelOverride", "requested_model"),
                          ("firstDispatchedModel", "first_dispatched_model"),
                          ("modelOverrideReason", "model_override_reason")):
            if data.get(raw):
                self.configuration[name] = data[raw]
        for raw, name in (("configuredModelMatchesActual", "preferred_model_matched"),
                          ("explicitModelMatchesPreference", "requested_model_matched")):
            if isinstance(data.get(raw), bool):
                self.configuration[name] = data[raw]
        if data.get("error"):
            self.last_error = str(data["error"])[:1000]
            self.completion["error"] = self.last_error
        if isinstance(data.get("cancelled"), bool):
            self.completion["cancelled"] = data["cancelled"]

    def shutdown_usage(self, metrics):
        self.usage_totals = {}
        self.final_aiu = None
        if is_metric(metrics.get("totalNanoAiu")):
            self.final_aiu = nano_to_aiu(metrics["totalNanoAiu"])
            self.aiu, self.aiu_known = self.final_aiu, True
        if is_metric(metrics.get("totalApiDurationMs")):
            self.usage_totals["api_duration_ms"] = metrics["totalApiDurationMs"]
        models = [metric.get("usage") or {} for metric in (metrics.get("modelMetrics") or {}).values()
                  if isinstance(metric, dict)]
        for raw, name in (("inputTokens", "input_tokens"), ("outputTokens", "output_tokens"),
                          ("cacheReadTokens", "cached_tokens"), ("cacheWriteTokens", "cache_write_tokens"),
                          ("reasoningTokens", "reasoning_tokens")):
            if models and all(is_metric(usage.get(raw)) for usage in models):
                self.usage_totals[name] = sum(usage[raw] for usage in models)

    def observed_aic(self, nano):
        if is_metric(nano):
            if self.final_aiu is not None:
                self.usage_totals.clear()
                self.completion.clear()
            self.final_aiu = None
            self.aiu += nano_to_aiu(nano)
            self.aiu_known = True

    def start_work(self):
        self.status, self.ended = "running", None
        self.native_terminal = False
        self.final_aiu = None
        self.usage_totals.clear()
        self.completion.clear()

    @property
    def label(self) -> str:
        if self.description or self.name:
            return self.description or self.name
        return "(unknown \u2013 launch args lost to log rotation)"

    @property
    def tool_summary(self) -> str:
        total = self.completion.get("total_tool_calls")
        if total is None:
            total = sum(self.tools.values()) if self.tools else None
        if total is None:
            return ""
        top = self.tools.most_common(1)
        return f"{total:g}" + (f" \u00b7 {top[0][0]}" if top else " total")

    @property
    def short_id(self) -> str:
        return (self.agent_id or self.call_id.rsplit("/", 1)[-1].removeprefix("call_"))[:8]

    def runtime(self, now: float) -> float:
        end = self.ended if self.ended is not None else now
        return max(0.0, end - (self.started if self.started is not None else end))

    def finish(self, when, status="done", native=False):
        if self.native_terminal and not native:
            return
        if self.ended is None or native:
            self.ended = when
        if native or status != "done" or self.status not in ("failed", "cancelled"):
            self.status = status
        self.native_terminal = native
        self.permissions.clear()
        self.inputs.clear()
        self.pending_tools.clear()

    def refresh_status(self, now: float):
        """A `task` call whose launch args/result never showed up (log rotation) is an orphan."""
        if self.ended is None and not self.launched and self.status == "starting":
            if now - (self.last_event or now) > ORPHAN_AFTER:
                self.status = "orphan"


class Monitor:
    def __init__(self, targets=None, max_age_h=24.0, source="all", cli_dir=None):
        self.targets = targets
        self.max_age_h = max_age_h
        self.source = source
        self.cli_dir = cli_dir
        self.offsets: dict[str, tuple[int, int]] = {}
        self.agents: dict[str, Agent] = {}          # call_id -> Agent
        self.by_agent_id: dict[str, Agent] = {}
        self.pending_reads: dict[str, str] = {}     # read_agent call_id -> agent_id
        self.pending_writes: dict[str, list[str]] = {}
        self.tool_owners = {}
        self.pending_permissions = {}
        self.pending_configuration = {}
        self.input_requests = {}
        self.input_aliases = {}
        self.sessions: dict[str, dict] = {}
        self.files: list[str] = []
        self.errors: list[str] = []
        self.cli_sessions: set[str] = set()
        self.seen_events: set[tuple[str, str]] = set()
        self.seen_ahp: set[bytes] = set()
        self.cli_files: dict[str, str] = {}
        self.last_discovery = None

    # -- io -----------------------------------------------------------------

    def refresh(self):
        now = time.monotonic()
        files = self.files
        if self.last_discovery is None or now - self.last_discovery >= 5:
            if self.targets:
                files = expand_target_list(self.targets)
            else:
                files = discover_logs(self.max_age_h) if self.source != "cli" else []
                if self.source != "vscode":
                    pattern = os.path.join(os.path.expanduser(self.cli_dir), "*", "events.jsonl") if self.cli_dir else CLI_GLOB
                    files += discover_logs(self.max_age_h, [pattern])
            files = sorted(set(os.path.realpath(p) for p in files))
            if self.source != "all":
                files = [p for p in files if (os.path.basename(p) == "events.jsonl") == (self.source == "cli")]
            self.last_discovery = now
        self.errors = []
        stats = {}
        for path in files:
            try:
                stats[path] = os.stat(path)
            except OSError as exc:
                self.errors.append(f"{path}: {exc}")
        self.files = files
        for path in stats:
            if os.path.basename(path) != "events.jsonl" or path in self.cli_files:
                continue
            try:
                with open(path, "rb") as fh:
                    first = fh.readline()
            except OSError as exc:
                self.report_error(f"{path}: {exc}")
                continue
            if not first.endswith(b"\n"):
                continue
            sid = os.path.basename(os.path.dirname(path))
            try:
                event = json.loads(first)
            except ValueError:
                event = {}
            if isinstance(event, dict) and event.get("type") == "session.start" and isinstance(event.get("data"), dict):
                recorded = event["data"].get("sessionId")
                if isinstance(recorded, str) and recorded:
                    sid = recorded
            self.cli_files[path] = sid
            self.prefer_cli(sid)
        for path in self.files:
            st = stats.get(path)
            if st is None:
                continue
            key = path
            inode, offset = self.offsets.get(key, (st.st_ino, 0))
            if inode != st.st_ino or st.st_size < offset:
                offset = 0                      # rotated or truncated
            if st.st_size == offset:
                continue
            try:
                with open(path, "rb") as fh:
                    fh.seek(offset)
                    for line in fh:
                        if not line.endswith(b"\n"):
                            break               # partial write, retry next cycle
                        offset = fh.tell()
                        text = line.decode("utf-8", "replace")
                        if os.path.basename(path) == "events.jsonl":
                            if path not in self.cli_files:
                                break
                            self.feed_cli(text, self.cli_files[path])
                        else:
                            self.feed(text)
            except OSError as exc:
                self.errors.append(f"{os.path.basename(path)}: {exc}")
                continue
            self.offsets[key] = (st.st_ino, offset)

    # -- parsing ------------------------------------------------------------

    def prefer_cli(self, sid):
        if sid in self.cli_sessions:
            return
        self.cli_sessions.add(sid)
        # Replace only the overlapping AHP session when its CLI history appears.
        for call, agent in list(self.agents.items()):
            if agent.session == sid and agent.source == "vscode":
                del self.agents[call]
                if agent.agent_id:
                    self.by_agent_id.pop(agent.agent_id, None)
        previous = self.sessions.pop(sid, None)
        if previous:
            state = self.state_for(sid, previous["last_event"])
            for key in ("repo", "branch", "inputs"):
                state[key] = previous[key]

    def start_input(self, sess, key, owner, ts, origin, tool_call=None):
        state = self.state_for(sess, ts)
        if (owner is not None and owner.ended is not None) or (
                owner is None and state["status"] in ("done", "failed", "cancelled")):
            return
        if (sess, key) in self.input_requests:
            previous, _ = self.input_requests[(sess, key)]
            if key in (previous.inputs if previous else state["inputs"]):
                return
            self.complete_input(sess, key)
        info = {"started": ts, "origin": origin}
        if tool_call:
            info["tool_call_id"] = tool_call
        self.input_requests[(sess, key)] = (owner, info)
        (owner.inputs if owner else state["inputs"])[key] = info
        state["last_event"] = max(state["last_event"], ts)
        if owner:
            owner.last_event = ts

    def complete_input(self, sess, key, ts=None):
        primary = self.input_aliases.pop((sess, key), key)
        if key.startswith("cli:") and any(
                sid == sess and alias.startswith("cli:") and target == primary
                for (sid, alias), target in self.input_aliases.items()):
            return
        pending = self.input_requests.pop((sess, primary), None)
        if pending:
            owner, _ = pending
            (owner.inputs if owner else self.sessions[sess]["inputs"]).pop(primary, None)
            if ts is not None:
                self.sessions[sess]["last_event"] = max(self.sessions[sess]["last_event"], ts)
                if owner:
                    owner.last_event = ts
        self.input_aliases = {alias: target for alias, target in self.input_aliases.items()
                              if alias[0] != sess or target != primary}

    def complete_input_tool(self, sess, call):
        for (sid, key), (_, info) in list(self.input_requests.items()):
            if sid == sess and info.get("tool_call_id") == call:
                self.complete_input(sess, key)

    def clear_inputs(self, sess, owner=None, all_owners=False, before=None):
        for (sid, key), (target, info) in list(self.input_requests.items()):
            if (sid == sess and (all_owners or target is owner)
                    and (before is None or info["started"] <= before)):
                self.complete_input(sess, key)

    def input_tool_started(self, sess, tool, call, ts, owner=None):
        if isinstance(tool, str) and tool.rsplit(".", 1)[-1] == "ask_user" and call:
            self.start_input(sess, f"tool:{call}", owner, ts, "ask_user", call)

    def adopt_inputs(self, agent):
        for (sess, key), (previous, info) in list(self.input_requests.items()):
            if (sess == agent.session and previous is not None and previous is not agent
                    and previous.call_id.rsplit("/", 1)[-1] == agent.call_id.rsplit("/", 1)[-1]
                    and key in previous.inputs):
                previous.inputs.pop(key)
                agent.inputs[key] = info
                self.input_requests[(sess, key)] = (agent, info)

    def agent_for_chat(self, chat, sess=None):
        raw_call = chat.rsplit("/", 1)[-1]
        candidates = [a for a in self.agents.values()
                      if a.call_id.rsplit("/", 1)[-1] == raw_call and (sess is None or a.session == sess)]
        return candidates[0] if len(candidates) == 1 else None

    def on_ahp_input(self, sess, kind, action, ts, owner=None):
        if kind in ("chat/inputCompleted", "session/inputNeededRemoved"):
            request_id = action.get("requestId") if kind == "chat/inputCompleted" else action.get("id")
            if isinstance(request_id, str):
                self.complete_input(sess, f"ahp:{request_id}", ts)
            return
        request = action.get("request") or {}
        outer_id = request.get("id")
        chat = request.get("chat") or ""
        if chat.startswith("ahp-chat://subagent"):
            owner = self.agent_for_chat(chat, sess)
            if owner is None:
                self.report_error(f"Input request for an unmapped subagent in {sess[:8]}")
                return
        if kind == "session/inputNeededSet":
            if request.get("kind") == "toolClientExecution":
                tool = request.get("toolCall") or {}
                call = tool.get("toolCallId")
                if call:
                    normalized = f"{sess}/{call}"
                    self.input_tool_started(sess, tool.get("toolName"), normalized, ts, owner)
                    if (sess, f"tool:{normalized}") in self.input_requests and isinstance(outer_id, str):
                        self.input_aliases[(sess, f"ahp:{outer_id}")] = f"tool:{normalized}"
                return
            if request.get("kind") != "chatInput":
                return
            request = request.get("request") or {}
        request_id = request.get("id")
        if not isinstance(request_id, str):
            self.report_error(f"Input request without id in {sess[:8]}")
            return
        self.start_input(sess, f"ahp:{request_id}", owner, ts, "vscode-input")
        if isinstance(outer_id, str):
            self.input_aliases[(sess, f"ahp:{outer_id}")] = f"ahp:{request_id}"

    def input_attention(self):
        return (sum(a.display_status == "input" for a in self.agents.values()),
                sum(session_status(st) == "input" for st in self.sessions.values()))

    @staticmethod
    def configure_agent(agent, data):
        if data.get("model"):
            agent.configuration["configured_model"] = data["model"]
            agent.model = data["model"]
        for raw, name in (("reasoningEffort", "reasoning_effort"), ("contextTier", "context_tier")):
            if data.get(raw):
                agent.configuration[name] = data[raw]
        if isinstance(data.get("multiTurn"), bool):
            agent.configuration["multi_turn"] = data["multiTurn"]

    def on_permission(self, sess, kind, data, owner, aid, ts):
        request = data.get("requestId")
        if not isinstance(request, str):
            self.report_error(f"Permission event without requestId in {sess[:8]}")
            return
        key = (sess, request)
        state = self.sessions[sess]
        if kind == "permission.requested":
            if data.get("resolvedByHook") or key in self.pending_permissions:
                return
            permission = data.get("permissionRequest") or {}
            call = permission.get("toolCallId")
            if owner is None and call:
                owner = self.tool_owners.get(f"{sess}/{call}")
            if owner is None and aid:
                self.report_error(f"Permission event for an unmapped subagent in {sess[:8]}")
                return
            if owner is not None and owner.ended is not None:
                return
            info = {"kind": permission.get("kind") or "permission", "started": ts}
            self.pending_permissions[key] = (owner, info)
            (owner.permissions if owner else state["permissions"])[request] = info
            if owner:
                owner.last_event = ts
        else:
            pending = self.pending_permissions.pop(key, None)
            if pending is None:
                return
            owner, info = pending
            (owner.permissions if owner else state["permissions"]).pop(request, None)
            result = (data.get("result") or {}).get("kind")
            if owner:
                owner.last_event = ts
                if result:
                    owner.permission_results[result] += 1
                    owner.last_permission = f"{info['kind']}: {result}"
                end = min(ts, owner.ended) if owner.ended is not None else ts
                owner.permission_wait += max(0.0, end - info["started"])

    def feed_cli(self, line: str, sess: str):
        if not any(f'"{kind}"' in line for kind in CLI_EVENTS):
            return
        try:
            evt = json.loads(line)
        except ValueError:
            self.report_error(f"CLI {sess[:8]}: invalid JSON event")
            return
        if not isinstance(evt, dict):
            return
        kind, data = evt.get("type"), evt.get("data")
        if kind not in CLI_EVENTS or not isinstance(data, dict):
            return
        event_id = evt.get("id")
        if isinstance(event_id, str):
            identity = (sess, event_id)
            if identity in self.seen_events:
                return
            self.seen_events.add(identity)
        ts = parse_ts(evt.get("timestamp")) or time.time()
        state = self.state_for(sess, ts)
        state["source"] = "cli"
        state["last_event"] = max(state["last_event"], ts)
        aid = evt.get("agentId")
        owner = self.by_agent_id.get(aid) if isinstance(aid, str) else None
        if owner is not None and owner.session != sess:
            owner = None
        raw_call = data.get("toolCallId")
        call = f"{sess}/{raw_call}" if isinstance(raw_call, str) else None

        if kind == "subagent.configured" and aid:
            if owner:
                self.configure_agent(owner, data)
                owner.last_event = ts
            else:
                self.pending_configuration[(sess, aid)] = data
            return
        if kind in ("permission.requested", "permission.completed"):
            self.on_permission(sess, kind, data, owner, aid, ts)
            return
        if kind in ("user_input.requested", "user_input.completed"):
            request_id = data.get("requestId")
            if not isinstance(request_id, str):
                self.report_error(f"User input event without requestId in {sess[:8]}")
                return
            alias = f"cli:{request_id}"
            if kind == "user_input.completed":
                self.complete_input(sess, alias, ts)
            else:
                owner = owner or self.tool_owners.get(call)
                if aid and owner is None:
                    self.report_error(f"User input for an unmapped subagent in {sess[:8]}")
                    return
                key = f"tool:{call}" if call else alias
                self.start_input(sess, key, owner, ts, "copilot-input", call)
                self.input_aliases[(sess, alias)] = key
            return

        if kind in ("subagent.started", "subagent.completed", "subagent.failed") and call:
            agent = self.agents.get(call)
            if agent is None:
                agent = Agent(call, sess, ts if kind == "subagent.started" else None)
                self.agents[call] = agent
            agent.source = "cli"
            self.adopt_inputs(agent)
            if isinstance(aid, str):
                agent.agent_id = aid
                self.by_agent_id[aid] = agent
            agent.agent_type = data.get("agentType") or data.get("agentName") or agent.agent_type
            agent.name = agent.name or data.get("agentDisplayName") or ""
            agent.description = agent.description or data.get("agentDescription") or ""
            agent.model = data.get("model") or agent.model
            agent.mode = data.get("executionMode") or agent.mode
            if "resumable" in data:
                agent.resumable = data["resumable"] is True
                agent.configuration["resumable"] = agent.resumable
            parent = self.by_agent_id.get(data.get("parentId"))
            if agent.parent is None and parent and parent.session == sess:
                agent.parent = parent.call_id
            config = self.pending_configuration.pop((sess, aid), None)
            if config:
                self.configure_agent(agent, config)
            agent.last_event = ts
            agent.launched = True
            if kind != "subagent.started":
                self.clear_inputs(sess, agent, before=ts)
                agent.reported_completion(data, ts)
            if kind == "subagent.started":
                if agent.started is None:
                    agent.started = ts
                agent.start_work()
            elif kind == "subagent.failed":
                agent.finish(ts, "failed", native=True)
            elif data.get("cancelled") is True:
                agent.finish(ts, "cancelled", native=True)
            elif agent.native_terminal:
                return
            elif agent.mode == "background" and agent.resumable:
                agent.status, agent.ended = "idle", None
            else:
                agent.finish(ts, native=True)
            return

        if kind == "tool.execution_start" and call:
            tool = data.get("toolName") or "?"
            if owner:
                owner.last_event = ts
                owner.tool_started(call, tool, ts)
                self.tool_owners[call] = owner
                owner.start_work()
            elif not aid:
                state["tools"][tool] += 1
                state["pending_tools"].add(call)
                state["status"], state["activity"] = "running", tool
            if tool == "task":
                agent = self.agents.setdefault(call, Agent(call, sess, ts, owner.call_id if owner else None))
                agent.source = "cli"
                self.adopt_inputs(agent)
            if tool in ("task", "read_agent", "write_agent"):
                self.on_ready({"toolCallId": call, "toolInput": data.get("arguments")}, ts)
            if owner is not None or not aid:
                self.input_tool_started(sess, tool, call, ts, owner)
            elif isinstance(tool, str) and tool.rsplit(".", 1)[-1] == "ask_user":
                self.report_error(f"Question tool for an unmapped subagent in {sess[:8]}")
            return

        if kind == "tool.execution_complete" and call:
            self.complete_input_tool(sess, call)
            owner = owner or self.tool_owners.get(call)
            self.tool_owners.pop(call, None)
            result = data.get("result") or {}
            error = data.get("error") or {}
            content = result.get("content") or error.get("message") or ""
            self.on_complete({
                "toolCallId": call, "success": data.get("success"),
                "result": {"content": [{"type": "text", "text": content}]},
            }, ts)
            if not aid:
                state["pending_tools"].discard(call)
            if owner:
                owner.last_event = ts
                owner.tool_completed(call, ts, data.get("success"), error.get("message") or error.get("code") or "")
            return

        if kind == "system.notification":
            notification = data.get("kind") or {}
            if isinstance(notification, dict) and notification.get("type") == "agent_idle":
                target = self.by_agent_id.get(notification.get("agentId"))
                if target and not target.native_terminal:
                    if target.resumable:
                        target.status, target.ended = "idle", None
                    elif target.ended is None:
                        target.finish(ts)
                    target.last_event = ts
            else:
                self.on_notification(str(data.get("content") or ""), ts, sess)
            return

        if aid:
            if owner:
                owner.last_event = ts
                if kind == "assistant.message":
                    owner.model = data.get("model") or owner.model
                elif kind == "session.model_change":
                    owner.model_changed(data, ts)
                elif kind in ("assistant.turn_start", "user.message"):
                    owner.start_work()
                elif kind in ("abort", "session.error"):
                    owner.last_error = str(data.get("message") or data.get("reason") or "")[:1000]
                    owner.finish(ts, "cancelled" if kind == "abort" else "failed")
                elif kind == "model.model_call_success":
                    self.cli_request_usage(data, owner)
            return

        if kind in ("session.start", "session.resume"):
            context = data.get("context") or {}
            state["cwd"] = context.get("cwd") or state["cwd"]
            state["model"] = data.get("selectedModel") or state["model"]
            state["status"], state["activity"] = "idle", ""
            if kind == "session.start":
                state["session_direct_aiu"] = 0.0
            state["direct_aiu"] = None
        elif kind == "session.model_change":
            state["model"] = data.get("newModel") or state["model"]
        elif kind == "user.message":
            if not state["title"]:
                state["title"] = clip(str(data.get("content") or ""), 160)
            state["turn_started"], state["turn_done"] = ts, None
            state["cli_turn_base"] = state["session_aiu"]
            state["turn_aiu"] = 0.0
            state["turn_aiu_known"] = False
            state["direct_aiu"] = None
            state["cli_direct_base"] = state["session_direct_aiu"]
            state["session_direct_aiu"] = None
            state["turn_in"] = state["turn_out"] = state["turn_cached"] = 0
            state["status"] = "running"
        elif kind == "assistant.turn_start":
            state["status"] = "running"
        elif kind == "assistant.turn_end" and not state["pending_tools"]:
            state["status"], state["activity"], state["turn_done"] = "idle", "", ts
        elif kind == "assistant.message":
            state["model"] = data.get("model") or state["model"]
        elif kind in ("session.usage_checkpoint", "session.shutdown"):
            if is_metric(data.get("totalNanoAiu")):
                state["session_aiu"] = max(state["session_aiu"], nano_to_aiu(data["totalNanoAiu"]))
                state["session_aiu_known"] = True
                state["turn_aiu_known"] = True
            state["turn_aiu"] = max(0.0, state["session_aiu"] - state["cli_turn_base"])
            main_metrics = (data.get("agentMetrics") or {}).get("main") or {}
            direct = main_metrics.get("totalNanoAiu")
            state["session_direct_aiu"] = nano_to_aiu(direct) if direct is not None else None
            if state["session_direct_aiu"] is not None and state["cli_direct_base"] is not None:
                state["direct_aiu"] = max(0.0, state["session_direct_aiu"] - state["cli_direct_base"])
            # Checkpoints expose the latest prompt size without storing conversation text.
            for cache in data.get("promptCacheBreakState") or []:
                if cache.get("conversation") != "main":
                    continue
                model = cache.get("lastActiveModel")
                metrics = (cache.get("models") or {}).get(model) or {}
                if metrics:
                    state["model"] = model or state["model"]
                    state["in_tokens"] = metrics.get("prompt_tokens") or 0
                    state["cached_tokens"] = metrics.get("cache_read") or 0
            if kind == "session.shutdown":
                self.clear_inputs(sess, all_owners=True)
                state["status"], state["activity"], state["turn_done"] = "done", "", ts
                state["model"] = data.get("currentModel") or state["model"]
                state["in_tokens"] = data.get("currentTokens") or state["in_tokens"]
                state["pending_tools"].clear()
                state["permissions"].clear()
                self.pending_permissions = {key: value for key, value in self.pending_permissions.items()
                                            if key[0] != sess}
                self.tool_owners = {key: value for key, value in self.tool_owners.items() if value.session != sess}
                for agent in self.agents.values():
                    if agent.session == sess and agent.ended is None:
                        agent.finish(ts, "cancelled" if agent.status in ("starting", "running") else "done")
                for agent_id, metrics in (data.get("agentMetrics") or {}).items():
                    agent = self.by_agent_id.get(agent_id)
                    if agent and agent.session == sess and isinstance(metrics, dict):
                        agent.shutdown_usage(metrics)
        elif kind == "model.model_call_success":
            usage = data.get("responseUsage") or {}
            state["in_tokens"] = usage.get("prompt_tokens") or 0
            state["out_tokens"] = usage.get("completion_tokens") or 0
            state["cached_tokens"] = (usage.get("prompt_tokens_details") or {}).get("cached_tokens") or 0
            state["turn_in"] += state["in_tokens"]
            state["turn_out"] += state["out_tokens"]
            state["turn_cached"] += state["cached_tokens"]
        elif kind in ("abort", "session.error", "session.task_complete"):
            if kind != "session.task_complete":
                self.clear_inputs(sess)
            status = "cancelled" if kind == "abort" else ("failed" if kind == "session.error" or data.get("success") is False else "idle")
            state["status"], state["turn_done"] = status, ts
            state["activity"] = data.get("message") or data.get("reason") or ""

    @staticmethod
    def cli_request_usage(data, agent):
        usage = data.get("responseUsage") or {}
        if is_metric(usage.get("prompt_tokens")) or is_metric(usage.get("completion_tokens")):
            agent.tokens_known = True
        agent.in_tokens = max(agent.in_tokens, usage.get("prompt_tokens") or 0)
        agent.out_tokens += usage.get("completion_tokens") or 0
        agent.cached_tokens = max(agent.cached_tokens, (usage.get("prompt_tokens_details") or {}).get("cached_tokens") or 0)
        agent.observed_aic((data.get("copilotUsage") or {}).get("total_nano_aiu"))

    def report_error(self, message):
        if message not in self.errors and len(self.errors) < 50:
            self.errors.append(message)

    def feed(self, line: str):
        if any(tok in line for tok in SKIP_TOKENS):
            return
        if not any(tok in line for tok in KEEP_TOKENS):
            return
        try:
            evt = json.loads(line)
        except ValueError:
            self.report_error("AHP: invalid JSON event")
            return
        if not isinstance(evt, dict):
            return
        fingerprint = hashlib.blake2b(line.encode("utf-8"), digest_size=16).digest()
        if fingerprint in self.seen_ahp:
            return
        self.seen_ahp.add(fingerprint)
        params = evt.get("params")
        if not isinstance(params, dict):
            return
        ts = parse_ts((evt.get("_ahpLog") or {}).get("ts")) or time.time()

        if evt.get("method") == "root/sessionSummaryChanged":
            sid = str(params.get("session") or "").rsplit("/", 1)[-1]
            if sid:
                self.on_meta(self.state_for(sid, ts), (params.get("changes") or {}).get("_meta") or {})
            return

        action = params.get("action")
        if not isinstance(action, dict):
            return
        channel = params.get("channel") or ""
        kind = action.get("type")

        if channel.startswith("ahp-chat://subagent"):
            self.on_subagent_channel(channel, kind, action, ts)
            return

        sess = session_of(channel)
        state = self.state_for(sess, ts)
        if kind in AHP_INPUT_EVENTS:
            self.on_ahp_input(sess, kind, action, ts)
            return
        if sess in self.cli_sessions:
            if kind == "session/metaChanged":
                self.on_meta(state, action.get("_meta") or {})
            elif kind == "chat/toolCallComplete":
                self.complete_input_tool(sess, f"{sess}/{action.get('toolCallId')}")
            elif kind == "chat/turnComplete":
                self.clear_inputs(sess, before=ts)
            return
        state["last_event"] = max(state["last_event"], ts)

        if kind == "chat/toolCallStart":
            if action.get("toolName"):
                state["tools"][action["toolName"]] += 1
            self.on_start(sess, action, ts)
            if action.get("toolCallId"):
                self.input_tool_started(sess, action.get("toolName"), f"{sess}/{action['toolCallId']}", ts)
        elif kind == "chat/toolCallReady":
            self.on_ready(action, ts)
        elif kind == "chat/toolCallComplete":
            self.complete_input_tool(sess, f"{sess}/{action.get('toolCallId')}")
            self.on_complete(action, ts)
        elif kind == "chat/responsePart":
            part = action.get("part") or {}
            if part.get("kind") == "systemNotification":
                self.on_notification(str(part.get("content") or ""), ts)
        elif kind == "chat/turnStarted":
            state["status"] = "running"
            state["turn_started"] = parse_ts(action.get("startedAt")) or ts
            state["turn_id"] = action.get("turnId")
            state["turn_done"] = None
            state["turn_aiu"] = state["direct_aiu"] = 0.0
            state["turn_aiu_known"] = False
            state["turn_in"] = state["turn_cached"] = state["turn_out"] = 0
            msg = action.get("message") or {}
            if (msg.get("origin") or {}).get("kind") == "systemNotification":
                self.on_notification(str(msg.get("text") or ""), ts)
        elif kind == "chat/turnComplete":
            self.clear_inputs(sess)
            state["turn_done"] = ts
            state["status"] = "idle"
        elif kind == "session/activityChanged":
            state["activity"] = action.get("activity") or ""
        elif kind == "chat/usage":
            usage = action.get("usage") or {}
            state["model"] = usage.get("model") or state["model"]
            state["in_tokens"] = usage.get("inputTokens") or 0
            state["out_tokens"] = usage.get("outputTokens") or 0
            state["cached_tokens"] = usage.get("cacheReadTokens") or 0
            self.on_usage_meta(state, usage.get("_meta") or {})
        elif kind == "session/metaChanged":
            self.on_meta(state, action.get("_meta") or {})

    def state_for(self, sess, ts):
        return self.sessions.setdefault(sess, {
            "activity": "", "turn_started": None, "turn_id": None, "turn_done": None,
            "model": "", "in_tokens": 0, "out_tokens": 0, "cached_tokens": 0, "last_event": ts,
            "repo": "", "branch": "",
            "turn_aiu": 0.0, "direct_aiu": None if sess in self.cli_sessions else 0.0, "session_aiu": 0.0,
            "turn_in": 0, "turn_cached": 0, "turn_out": 0,
            "premium_pct": None, "ctx_limit": 0,
            "source": "cli" if sess in self.cli_sessions else "vscode",
            "status": "unknown", "title": "", "cwd": "", "tools": collections.Counter(),
            "pending_tools": set(), "cli_turn_base": 0.0,
            "session_direct_aiu": None, "cli_direct_base": None,
            "session_aiu_known": False, "turn_aiu_known": False, "permissions": {}, "inputs": {},
        })

    @staticmethod
    def on_usage_meta(state, meta):
        """Main-session usage reports cumulative turn totals, so take the maximum."""
        cu = meta.get("copilotUsage") or {}
        state["turn_aiu_known"] = state["turn_aiu_known"] or is_metric(cu.get("totalNanoAiu"))
        state["session_aiu_known"] = state["session_aiu_known"] or is_metric(cu.get("sessionTotalNanoAiu"))
        state["turn_aiu"] = max(state["turn_aiu"], nano_to_aiu(cu.get("totalNanoAiu")))
        state["session_aiu"] = max(state["session_aiu"], nano_to_aiu(cu.get("sessionTotalNanoAiu")))
        direct = (meta.get("directCopilotUsage") or {}).get("totalNanoAiu")
        state["direct_aiu"] = max(state["direct_aiu"] or 0.0, nano_to_aiu(direct))
        totals = meta.get("turnTokenTotals") or []
        if totals:
            state["turn_in"] = sum(t.get("inputTokens") or 0 for t in totals)
            state["turn_cached"] = sum(t.get("cachedTokens") or 0 for t in totals)
            state["turn_out"] = sum(t.get("outputTokens") or 0 for t in totals)
        premium = (meta.get("quotaSnapshots") or {}).get("premium_interactions") or {}
        if premium.get("remainingPercentage") is not None:
            state["premium_pct"] = 100.0 - premium["remainingPercentage"]
        limit = (meta.get("contextAttribution") or {}).get("limit")
        if limit:
            state["ctx_limit"] = limit

    @staticmethod
    def on_meta(state, meta):
        git = meta.get("git") or {}
        if git.get("githubRepo"):
            state["repo"] = git["githubRepo"]
        if git.get("branchName"):
            state["branch"] = git["branchName"]
        cache = meta.get("vscode.promptCache") or {}
        if cache.get("modelId"):
            state["model"] = state["model"] or cache["modelId"]

    def session_label(self, sid: str) -> str:
        st = self.sessions.get(sid) or {}
        repo = st.get("repo") or ""
        branch = st.get("branch") or ""
        head = f"{repo}@{branch}" if repo and branch else (repo or os.path.basename(st.get("cwd", "").rstrip("/\\")) or sid[:8])
        return head

    def on_start(self, sess, action, ts):
        tool = action.get("toolName")
        call_id = action.get("toolCallId")
        if tool != "task" or not call_id:
            return
        agent = self.agents.get(call_id)
        if agent is None:
            agent = Agent(call_id, sess, ts)
            self.agents[call_id] = agent
        agent.status = "starting"
        agent.last_event = ts

    def on_ready(self, action, ts):
        call_id = action.get("toolCallId")
        raw = action.get("toolInput")
        if not call_id or not isinstance(raw, (str, dict)):
            return
        try:
            args = json.loads(raw) if isinstance(raw, str) else raw
        except ValueError:
            return
        if not isinstance(args, dict):
            return
        agent = self.agents.get(call_id)
        if agent is not None:                       # this is the task launch itself
            agent.launched = True
            agent.name = args.get("name") or agent.name
            agent.description = args.get("description") or agent.description
            agent.agent_type = args.get("agent_type") or agent.agent_type
            agent.model = args.get("model") or agent.model
            for raw, name in (("model", "requested_model"), ("reasoning_effort", "reasoning_effort"),
                              ("context_tier", "context_tier")):
                if args.get(raw):
                    agent.configuration[name] = args[raw]
            agent.mode = args.get("mode") or agent.mode
            agent.prompt = args.get("prompt") or agent.prompt
            agent.last_event = ts
            return
        # write_agent / read_agent referencing existing agents
        targets = []
        if isinstance(args.get("agent_id"), str):
            targets.append(args["agent_id"])
        if isinstance(args.get("agent_ids"), list):
            targets += [a for a in args["agent_ids"] if isinstance(a, str)]
        if "message" in args:
            self.pending_writes[call_id] = targets
            for aid in targets:
                found = self.by_agent_id.get(aid)
                if found:
                    found.messages += 1
                    found.last_event = ts
        elif targets:
            self.pending_reads[call_id] = targets[0]

    def on_complete(self, action, ts):
        call_id = action.get("toolCallId")
        result = action.get("result") or {}
        meta = action.get("_meta") or {}
        body = text_of(result)
        written = self.pending_writes.pop(call_id, [])
        if action.get("success") is not False and not result.get("isError"):
            for aid in written:
                target = self.by_agent_id.get(aid)
                if target:
                    target.start_work()
                    target.last_event = ts

        agent = self.agents.get(call_id)
        if agent is not None:
            if agent.native_terminal:
                agent.result_preview = body[:4000]
                agent.last_event = ts
                return
            agent.launched = True
            agent.description = meta.get("subagentDescription") or agent.description
            agent.agent_type = meta.get("subagentAgentName") or agent.agent_type
            match = AGENT_ID_RE.search(body)
            if match:
                agent.agent_id = match.group(1)
                self.by_agent_id[agent.agent_id] = agent
                agent.mode = "background"
                if agent.status == "starting":
                    agent.status = "running"
            else:
                agent.mode = agent.mode if agent.mode != "sync" else "sync"
                agent.result_preview = body[:4000]
                failed = action.get("success") is False or result.get("isError") is True
                agent.finish(ts, "failed" if failed else "done")
                if failed and body:
                    agent.last_error = body[:1000]
            agent.last_event = ts
            return

        aid = self.pending_reads.pop(call_id, None)
        if aid:
            target = self.by_agent_id.get(aid)
            if target:
                target.reads += 1
                target.last_event = ts
                low = body[:200].lower()
                if "still running" in low or "is running" in low:
                    target.start_work()
                elif not target.native_terminal and ("is idle" in low or "waiting for messages" in low):
                    target.status = "idle"
                    target.ended = None
                elif target.ended is None and ("completed" in low or "failed" in low):
                    target.finish(ts, "failed" if "failed" in low else "done")
                if target.ended is None:
                    target.result_preview = body[:4000]

    def on_notification(self, content: str, ts: float, session=None):
        content = content.strip()
        match = BG_DONE_RE.search(content)
        if match:
            target = self.by_agent_id.get(match.group(1))
            if target:
                target.finish(ts)
                target.last_event = ts
            return
        match = DESC_DONE_RE.match(content)
        if match:
            label = match.group(1).strip()
            for agent in self.agents.values():
                if (agent.ended is None and (session is None or agent.session == session)
                        and label in (agent.description, agent.name)):
                    agent.finish(ts)
                    agent.last_event = ts
                    return

    def on_subagent_channel(self, channel, kind, action, ts):
        call_id = channel.rsplit("/", 1)[-1]
        if kind in AHP_INPUT_EVENTS:
            owner = self.agent_for_chat(channel)
            if owner:
                self.on_ahp_input(owner.session, kind, action, ts, owner)
            else:
                self.report_error("Input event on an unmapped subagent channel")
            return
        if kind == "chat/turnComplete":
            owner = self.agent_for_chat(channel)
            if owner:
                self.clear_inputs(owner.session, owner, before=ts)
        agent = self.agents.get(call_id)
        if agent is None or agent.session in self.cli_sessions:
            return
        agent.last_event = ts
        if kind == "chat/toolCallStart":
            tool = action.get("toolName")
            if tool:
                agent.tool_started(action.get("toolCallId"), tool, ts)
                if action.get("toolCallId"):
                    self.input_tool_started(agent.session, tool, f"{agent.session}/{action['toolCallId']}", ts, agent)
            if tool == "task":                      # this agent delegates further
                child_id = action.get("toolCallId")
                if child_id and child_id not in self.agents:
                    self.agents[child_id] = Agent(child_id, agent.session, ts, parent=call_id)
        elif kind == "chat/toolCallReady":
            self.on_ready(action, ts)
        elif kind == "chat/toolCallComplete":
            self.complete_input_tool(agent.session, f"{agent.session}/{action.get('toolCallId')}")
            result = action.get("result") or {}
            success = action.get("success")
            if not isinstance(success, bool) and isinstance(result.get("isError"), bool):
                success = not result["isError"]
            agent.tool_completed(action.get("toolCallId"), ts, success,
                                 text_of(result) if success is False else "")
            self.on_complete(action, ts)
        elif kind == "chat/usage":
            usage = action.get("usage") or {}
            if is_metric(usage.get("inputTokens")) or is_metric(usage.get("outputTokens")):
                agent.tokens_known = True
            agent.model = usage.get("model") or agent.model
            agent.in_tokens = max(agent.in_tokens, usage.get("inputTokens") or 0)
            agent.out_tokens += usage.get("outputTokens") or 0
            agent.cached_tokens = max(agent.cached_tokens, usage.get("cacheReadTokens") or 0)
            meta = usage.get("_meta") or {}
            agent.cost += meta.get("cost") or 0
            # subagent usage is reported per request, so accumulate it
            agent.observed_aic((meta.get("copilotUsage") or {}).get("totalNanoAiu"))
        elif kind == "session/chatAdded":
            title = (action.get("summary") or {}).get("title")
            if title and not agent.name:
                agent.name = title
        elif kind == "chat/turnComplete" and agent.mode != "background":
            agent.finish(ts)

    # -- views --------------------------------------------------------------

    def snapshot(self, show_done: bool, sort_key: str):
        now = time.time()
        rows = []
        for a in self.agents.values():
            a.refresh_status(now)
            if a.status == "orphan" and not show_done:
                continue
            if a.ended is not None and not show_done:
                continue
            rows.append(a)
        keys = {
            "runtime": lambda a: -a.runtime(now),
            "start": lambda a: -(a.started or 0),
            "idle": lambda a: -(now - (a.last_event or now)),
            "name": lambda a: a.label.lower(),
            "status": lambda a: (STATUS_ORDER.get(a.display_status, 99), -a.runtime(now)),
        }
        rows.sort(key=keys.get(sort_key, keys["runtime"]))
        return rows, now

    def select(self, show_done, sort_key, sess_filter=None, query="", activity="all"):
        if activity not in ACTIVITY_FILTERS:
            raise ValueError(f"Unknown activity filter: {activity}")
        rows, now = self.snapshot(show_done, sort_key)
        def matches(status, last_event):
            if activity == "active":
                return status in ("running", "starting")
            if activity == "recent":
                return last_event is not None and last_event >= now - RECENT_ACTIVITY_SECONDS
            return True

        rows = [a for a in rows if matches(a.display_status, a.last_event)
                and (activity != "active" or a.ended is None)]
        query = query.casefold()
        agent_sessions = {a.session for a in rows}
        sessions = {
            sid for sid, st in self.sessions.items()
            if (not sess_filter or sid.startswith(sess_filter))
            and (show_done or sid in agent_sessions or st["status"] not in ("done", "failed", "cancelled"))
            and (sid in agent_sessions or matches(session_status(st), st["last_event"]))
        }
        matching = {
            sid for sid in sessions
            if not query or query in " ".join((
                sid, self.session_label(sid), self.sessions[sid]["title"],
                self.sessions[sid]["model"],
            )).casefold()
        }
        rows = [a for a in rows if a.session in sessions and (
            a.session in matching or query in " ".join((
                a.label, a.name, a.agent_id or a.call_id, a.agent_type, a.model,
            )).casefold()
        )]
        return rows, now, matching | {a.session for a in rows}

    def counts(self, agents=None):
        now = time.time()
        agents = list(self.agents.values()) if agents is None else agents
        for a in agents:
            a.refresh_status(now)
        live = [a for a in agents if a.ended is None]
        running = sum(1 for a in live if a.display_status == "running")
        starting = sum(1 for a in live if a.display_status == "starting")
        idle = sum(1 for a in live if a.display_status == "idle")
        done = sum(1 for a in agents if a.ended is not None)
        return running, starting, idle, done

    def aic_total(self):
        known = [st["session_aiu"] for st in self.sessions.values()
                 if st.get("session_aiu_known") or st["session_aiu"]]
        return (sum(known) if known else None), len(known) == len(self.sessions)


def expand_target_list(targets):
    out = []
    for t in targets:
        out += expand_target(t)
    return sorted(set(out))


